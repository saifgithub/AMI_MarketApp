# AMI Trade — local dev environment variables.
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; never commit secrets.

# Environment
ENV=local

# Database (local — managed by docker-compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ami_trade

# Redis (local — managed by docker-compose)
REDIS_URL=redis://localhost:6379/0

# Supabase (set after running self-hosted supabase OR pointing at supabase cloud)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# LLM providers (at minimum, set OPENROUTER + ANTHROPIC)
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
DEEPSEEK_API_KEY=

# Email / SMS / push
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_KEY=

# TTS
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
ELEVENLABS_API_KEY=

# Observability
SENTRY_DSN=
POSTHOG_API_KEY=

# Cloudflare Tunnel (only needed if exposing dev API externally)
# Create the tunnel in CF dashboard → copy the token here
CF_TUNNEL_TOKEN=

# Server
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
