# AMI Trade — local dev environment variables.
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; never commit secrets.

# Environment
ENV=local

# Database (local — managed by docker-compose; host port is 5434 to avoid
# clashing with other Postgres instances. Leave unset and the backend falls
# back to a sqlite file under backend/.local.db — fine for solo dev/tests.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5434/ami_trade

# Redis (local — managed by docker-compose)
REDIS_URL=redis://localhost:6379/0

# Supabase (set after running self-hosted supabase OR pointing at supabase cloud)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# LLM providers (at minimum, set OPENROUTER + ANTHROPIC)
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
DEEPSEEK_API_KEY=

# On-prem vLLM (OpenAI-compatible). When VLLM_BASE_URL is set the gateway
# routes every LLM call here first, falling back to Anthropic or mock.
VLLM_BASE_URL=http://192.168.20.74:8000
VLLM_MODEL=gemma-4-31b-it-nvfp4
VLLM_API_KEY=

# Market data — set true to quote real Yahoo prices instead of the mock walk.
USE_REAL_MARKET_DATA=true

# Email / SMS / push
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_KEY=

# TTS
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
ELEVENLABS_API_KEY=

# Observability
SENTRY_DSN=
POSTHOG_API_KEY=

# Cloudflare Tunnel (only needed if exposing dev API externally)
# Create the tunnel in CF dashboard → copy the token here
CF_TUNNEL_TOKEN=

# Server
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
