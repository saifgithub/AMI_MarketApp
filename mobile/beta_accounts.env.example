# beta_accounts.env.example — template for mobile/beta_accounts.env (gitignored).
#
# CR267 WP-49 (company-account migration, CR258). Read ONLY by
# `--channel beta` of scripts/build_testflight.sh, build_playstore.sh and
# publish_playstore.sh (via scripts/lib/release_channel.sh). Alpha builds never
# read this file. Copy to mobile/beta_accounts.env and fill each value once.
#
# Format: KEY=VALUE, one per line. The file is parsed, never executed. A key
# already exported in your shell wins over this file. No secrets belong HERE
# except the optional public RevenueCat SDK keys; passwords, .p8 files,
# keystores and service-account JSON stay outside the repo and are referenced
# by path. If any [REQUIRED] key is missing, or still holds the founder's
# personal-account value, the Beta build refuses and lists every offender.
#
# Plan, values and console order:
# docs/forward_planning/CR258_company_account_migration/wp49_prep_2026-11-20.md

# ── Apple (company Organization account) ─────────────────────────────────────
# [REQUIRED ios] Company bundle ID (App ID registered in the company account). Must not be ai.agenticmarketintel.amiTrade.
AMI_BETA_IOS_BUNDLE_ID=
# [REQUIRED ios] Company Apple Developer Team ID: 10 upper-case letters/digits (developer.apple.com > Membership). Must not be S7RBWM4879.
AMI_BETA_APPLE_TEAM_ID=
# [REQUIRED ios] Company App Store Connect API key ID (App Store Connect > Users and Access > Integrations). The AuthKey_<ID>.p8 goes in ~/.appstoreconnect/private_keys/.
AMI_BETA_APP_STORE_API_KEY_ID=
# [REQUIRED ios] Company App Store Connect issuer UUID (same page as the key).
AMI_BETA_APP_STORE_API_ISSUER=

# ── Google Play (company Organization account) ───────────────────────────────
# [REQUIRED android] Company Play package name (permanent once the app is created). Must not be ai.agenticmarketintel.ami_trade.
AMI_BETA_ANDROID_APPLICATION_ID=
# [REQUIRED android] Absolute path to the company UPLOAD keystore's keystore.properties (storeFile/storePassword/keyAlias/keyPassword), outside the repo. Must not be ~/.android-keys/keystore.properties.
AMI_BETA_ANDROID_KEYSTORE_PROPERTIES=
# [REQUIRED for publish_playstore.sh] Absolute path to the company Play service-account JSON (Play Console > Setup > API access), outside the repo. Must not be ~/.android-keys/play-service-account.json.
AMI_BETA_PLAY_SERVICE_ACCOUNT_JSON=
# [REQUIRED android] Company Google Cloud OAuth 2.0 Web client ID (Google Sign-In `serverClientId`; also the backend GOOGLE_AUDIENCES for Beta).
AMI_BETA_GOOGLE_OAUTH_WEB_CLIENT_ID=

# ── Services ─────────────────────────────────────────────────────────────────
# [REQUIRED] Beta OneSignal app ID (UUID). A new OneSignal app: the iOS APNs key is team-bound, so the personal Alpha app cannot be reused.
AMI_BETA_ONESIGNAL_APP_ID=
# [REQUIRED] Sentry DSN for the Beta project (WP-53 crash-free figure). https://<key>@<host>/<project>
SENTRY_DSN=
# [OPTIONAL] Company RevenueCat public iOS SDK key (appl_...). Empty = build with --no-billing (RevenueCat stays parked, WP-49 item 1). Never inherits Alpha's key.
AMI_BETA_REVENUECAT_IOS_SDK_KEY=
# [OPTIONAL] Company RevenueCat public Android SDK key (goog_...). Empty = build with --no-billing.
AMI_BETA_REVENUECAT_ANDROID_SDK_KEY=
# [OPTIONAL] Beta API URL. Default https://api-beta.agenticmarketintel.ai
AMI_API_URL_BETA=
