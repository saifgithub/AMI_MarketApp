<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSMicrophoneUsageDescription</key>
	<string>AMI Trade does not use the microphone.</string>
	<!-- ITMS-90683, 2026-08-09. Required not by us but by the OneSignal push
	     SDK: its default `OneSignalComplete` subspec pulls in
	     `OneSignalLocation`, which references CoreLocation. AMI Trade never
	     requests location and never enables OneSignal's location features, so
	     this prompt can never actually appear — but App Store Connect refuses
	     the binary without the key. Wording follows the microphone precedent
	     above rather than inventing a purpose we do not have.
	     The better fix is to drop to the `OneSignal` subspec (which excludes
	     Location) — filed separately, because it risks push and push is live. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>AMI Trade does not use your location.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>AMI Trade does not use your location.</string>
	<key>NSCameraUsageDescription</key>
	<string>Attach a photo to your in-app bug report.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Pick a screenshot to attach to your in-app bug report.</string>
	<!-- CR122-MOBILE-C: Google Mobile Ads. GADApplicationIdentifier is
	     GOOGLE'S PUBLISHED SAMPLE iOS app id, committed on purpose — the GMA
	     SDK hard-crashes at launch when the key is absent once the plugin is
	     linked, and real ids are Saiful's AdMob account material (swap step
	     in docs/forward_planning/CR122_ads_monetization/
	     CR122_admob_compliance_and_liaison.md). GADDelayAppMeasurementInit
	     keeps the native SDK dormant at process launch; measurement starts
	     only if Dart calls MobileAds.initialize(), which never happens
	     without the ADMOB_MODE dart-define. The ATT purpose string shows on
	     the OS tracking prompt the UMP flow triggers (ads.md:106); the
	     SKAdNetwork ids are Google's published attribution set (primary id —
	     the full 50-entry list ships with the liaison step, same doc). -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-3940256099942544~1458002511</string>
	<key>GADDelayAppMeasurementInit</key>
	<true/>
	<key>NSUserTrackingUsageDescription</key>
	<string>Allowing tracking lets the ads on the free Floor Pass plan be more relevant. If you decline, you still see ads — just non-personalised.</string>
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>AMI Trade</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>ami_trade</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- CR027: OneSignal push. Lets the system wake the app for a silent/
	     content-available push (delivery receipts, badge/content updates)
	     without the app being foregrounded. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
