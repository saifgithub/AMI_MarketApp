    "gamesBoardTitle": "Standings",
    "@gamesBoardTitle": {"description": "CR109 slice 3c/4. App-bar title of the field board \u2014 where you stand against every other entrant in your run. NEW key. retranslate:[ar,ms]"},
    "gamesBoardCta": "SEE THE FIELD",
    "@gamesBoardCta": {"description": "CR109. Button on the run screen that opens the field board. Upper-case in EN by HexButton convention; translators should use their language's natural emphasis rather than forcing caps. NEW key. retranslate:[ar,ms]"},
    "gamesBoardYouAre": "You're #{rank} of {count}",
    "@gamesBoardYouAre": {"description": "CR109 \u00a76.1. The player's own standing, shown at the top of the board. Rank is on percentage return only, never on money. NEW key. retranslate:[ar,ms]", "placeholders": {"rank": {"type": "int", "example": "2"}, "count": {"type": "int", "example": "7"}}},
    "gamesBoardNotRankedYet": "Not ranked yet",
    "@gamesBoardNotRankedYet": {"description": "CR109. Shown instead of a position when the player's run has no completed US close, so there is nothing to rank. Deliberately not '0%' and not 'last' \u2014 unmeasured is a different fact from flat. NEW key. retranslate:[ar,ms]"},
    "gamesBoardStandingsClosed": "Standings open after the first US close.",
    "@gamesBoardStandingsClosed": {"description": "CR109 \u00a710. Empty-state line for a field where no entrant has a completed close yet. NEW key. retranslate:[ar,ms]"},
    "gamesBoardUpdatesNote": "Standings move once per US close \u2014 not tick by tick.",
    "@gamesBoardUpdatesNote": {"description": "CR109 \u00a710. Said out loud so a player watching an unchanged number all afternoon does not conclude the board is broken (CR040 degrade-loudly applies to staleness too). NEW key. retranslate:[ar,ms]"},
    "gamesBoardDeskChip": "DESK",
    "@gamesBoardDeskChip": {"description": "CR109 \u00a711.2. Chip marking an entrant as an AMI-run strategy desk rather than a person. Disclosure is mandatory on every surface that renders an entrant. NEW key. retranslate:[ar,ms]"},
    "gamesBoardYouChip": "YOU",
    "@gamesBoardYouChip": {"description": "CR109. Chip marking the player's own row on the board. NEW key. retranslate:[ar,ms]"},
    "gamesBoardNoCloseYet": "No close yet",
    "@gamesBoardNoCloseYet": {"description": "CR109. Sub-label on an entrant row whose run has not been measured \u2014 shown in place of a return percentage. NEW key. retranslate:[ar,ms]"},
    "gamesBoardEntrants": "{count, plural, =1{1 entrant} other{{count} entrants}}",
    "@gamesBoardEntrants": {"description": "CR109. Entrant count for the field, shown under the board title. NEW key. retranslate:[ar,ms]", "placeholders": {"count": {"type": "int", "example": "7"}}},
    "gamesBoardDeskCount": "{count, plural, =1{including 1 house desk} other{including {count} house desks}}",
    "@gamesBoardDeskCount": {"description": "CR109 \u00a711.2. How many of the entrants are AMI-run strategy desks. Disclosed at field level as well as per row. NEW key. retranslate:[ar,ms]", "placeholders": {"count": {"type": "int", "example": "5"}}},
    "gamesBoardEmpty": "No one has entered this field yet.",
    "@gamesBoardEmpty": {"description": "CR109. Board empty state. NEW key. retranslate:[ar,ms]"},
    "gamesDesksTitle": "House desks",
    "@gamesDesksTitle": {"description": "CR109 \u00a711.2. Title of the sheet listing every AMI-run strategy desk and its published rule. NEW key. retranslate:[ar,ms]"},
    "gamesDesksIntro": "Desks are AMI-run strategies, not people. Every desk's rule is published, and it trades real prices and pays the same costs you do.",
    "@gamesDesksIntro": {"description": "CR109 \u00a711.2. Disclosure copy for the house desks. Must never imply a desk is a person, and must say the performance is real rather than generated to look plausible. Say AMI, never 'the AI'. NEW key. retranslate:[ar,ms]"},
    "gamesDeskRuleTitle": "How this desk trades",
    "@gamesDeskRuleTitle": {"description": "CR109 \u00a711.2. Header above one desk's published selection rule. NEW key. retranslate:[ar,ms]"},
    "gamesDeskUniverse": "{count, plural, =1{Selects from 1 published name} other{Selects from {count} published names}}",
    "@gamesDeskUniverse": {"description": "CR109 \u00a711.2. The size of the published universe a desk selects from \u2014 part of making a desk reproducible by hand. NEW key. retranslate:[ar,ms]", "placeholders": {"count": {"type": "int", "example": "48"}}},
    "gamesLobbyTitle": "Choose a game",
    "@gamesLobbyTitle": {"description": "CR109 slice 6. App-bar title of the cadence lobby \u2014 the five games (weekly, monthly, quarterly, half-year, annual) a player can enter. NEW key. retranslate:[ar,ms]"},
    "gamesLobbyCta": "ALL GAMES",
    "@gamesLobbyCta": {"description": "CR109 slice 6. Button opening the cadence lobby from the games home screen. NEW key. retranslate:[ar,ms]"},
    "gamesLobbyIntro": "One run of each at a time \u2014 five books, never two of a kind.",
    "@gamesLobbyIntro": {"description": "CR109 \u00a74.1. States the one-live-run-per-cadence rule at the point of choice. It is an anti-farm rule (parallel entries in one cadence are strictly +EV), not a UI limit, but the player only needs the rule. NEW key. retranslate:[ar,ms]"},
    "gamesCadenceWeek": "Weekly",
    "@gamesCadenceWeek": {"description": "CR109. Name of the weekly cadence. NEW key. retranslate:[ar,ms]"},
    "gamesCadenceMonth": "Monthly",
    "@gamesCadenceMonth": {"description": "CR109 slice 6. Name of the monthly cadence. NEW key. retranslate:[ar,ms]"},
    "gamesCadenceQuarter": "Quarterly",
    "@gamesCadenceQuarter": {"description": "CR109 slice 6. Name of the quarterly cadence. NEW key. retranslate:[ar,ms]"},
    "gamesCadenceHalf": "Half-year",
    "@gamesCadenceHalf": {"description": "CR109 slice 6. Name of the six-month cadence. NEW key. retranslate:[ar,ms]"},
    "gamesCadenceYear": "Annual",
    "@gamesCadenceYear": {"description": "CR109 slice 6. Name of the annual cadence. NEW key. retranslate:[ar,ms]"},
    "gamesCadenceRuns": "{start} \u2192 {end}",
    "@gamesCadenceRuns": {"description": "CR109. The dates one cadence's next field runs between. NEW key. retranslate:[ar,ms]", "placeholders": {"start": {"type": "String", "example": "17 Aug"}, "end": {"type": "String", "example": "21 Aug"}}},
    "gamesCadenceYoureIn": "You're in",
    "@gamesCadenceYoureIn": {"description": "CR109 \u00a74.1. Shown in place of the ENTER action when the player already holds a live run of that cadence. NEW key. retranslate:[ar,ms]"},
    "gamesCadenceEntryClosed": "Entry closed \u2014 next one opens when this run starts",
    "@gamesCadenceEntryClosed": {"description": "CR109. Shown when a cadence's field has locked, so the player must wait for the following period. Says WHEN the next chance comes rather than only that this one is gone. NEW key. retranslate:[ar,ms]"},
    "gamesCadenceWeightNote": "Worth {gain}\u00d7 a weekly win",
    "@gamesCadenceWeightNote": {"description": "CR109 \u00a76.3. How much a longer cadence pays relative to a week, so the player can see the tradeoff before committing. NEW key. retranslate:[ar,ms]", "placeholders": {"gain": {"type": "String", "example": "13"}}},
    "gamesLobbyEnterCta": "ENTER THIS FIELD",
    "@gamesLobbyEnterCta": {"description": "CR109 slice 6. Entry action on a cadence row in the lobby. Cadence-NEUTRAL on purpose: `gamesEnterCta` reads \"enter this week's field\", which is wrong copy on a Monthly or Quarterly row. NEW key. retranslate:[ar,ms]"},
    "gamesTicketStepSizeSell": "HOW MUCH OF THE POSITION",
    "@gamesTicketStepSizeSell": {"description": "CR109 DEF259. Step-2 label when the ticket is selling. The percentage divides the POSITION, not the cash \u2014 a different denominator from the buy step, so it gets its own label rather than reusing gamesTicketStepSize. NEW key. retranslate:[ar,ms]"},
    "gamesTicketSizeShares": "{pct}% \u00b7 {shares} shares",
    "@gamesTicketSizeShares": {"description": "CR109 DEF259. Size readout on a SELL: shares, not AMI Cash. A dollar figure here would be misleading \u2014 the proceeds depend on the fill price, which for a queued order is not known until the next US open. NEW key. retranslate:[ar,ms]", "placeholders": {"pct": {"type": "String", "example": "50"}, "shares": {"type": "String", "example": "1.5958"}}},
    "gamesTicketSizeCloseAll": "Close it",
    "@gamesTicketSizeCloseAll": {"description": "CR109 DEF259. The 100% chip on a SELL \u2014 says what it does (closes the position) rather than reusing the buy side's 'all in', which means the opposite thing. NEW key. retranslate:[ar,ms]"},
    "gamesSellCta": "SELL",
    "@gamesSellCta": {"description": "CR109 DEF259. Action on a position row that opens the ticket in sell mode. Until this shipped there was no way to close a game position at all \u2014 the only exit was the run ending. NEW key. retranslate:[ar,ms]"},
    "gamesSellTitle": "Sell {ticker}",
    "@gamesSellTitle": {"description": "CR109 DEF259. Header of the ticket when it opens in sell mode on a named position. NEW key. retranslate:[ar,ms]", "placeholders": {"ticker": {"type": "String", "example": "AAPL"}}},
    "gamesSellHeld": "You hold {shares} shares",
    "@gamesSellHeld": {"description": "CR109 DEF259. The position being sold from, shown above the size step so the percentage has a visible denominator. NEW key. retranslate:[ar,ms]", "placeholders": {"shares": {"type": "String", "example": "3.1916"}}},
    "gamesNoShortingNote": "Long only \u2014 a sell closes what you hold, it never opens a short.",
    "@gamesNoShortingNote": {"description": "CR109. RETIRED by Amendment G \u2014 shorting now exists in the game, so this sentence is no longer true. Superseded by gamesSellClosesOnlyNote. Kept only so a stale build's lookup does not throw; delete once no shipped build references it. retranslate:[ar,ms]"},
    "gamesSellClosesOnlyNote": "A sell closes what you hold. To open a short, start a new trade and pick SHORT.",
    "@gamesSellClosesOnlyNote": {"description": "CR109 Amendment G. Replaces gamesNoShortingNote on the sell ticket. One order can never close a long AND open a short \u2014 the engine refuses a sell beyond the held quantity \u2014 so this points at the way to do it rather than saying it cannot be done. NEW key. retranslate:[ar,ms]"},
    "gamesTicketStepDirection": "DIRECTION",
    "@gamesTicketStepDirection": {"description": "CR109 Amendment G. Label above the long/short toggle on the trade ticket. Sits ABOVE the ticker because it changes what the size chips mean. NEW key. retranslate:[ar,ms]"},
    "gamesDirectionLong": "LONG",
    "@gamesDirectionLong": {"description": "CR109 Amendment G. The buy side of the direction toggle. 'LONG' rather than 'BUY' so it reads as the opposite of SHORT. NEW key. retranslate:[ar,ms]"},
    "gamesDirectionShort": "SHORT",
    "@gamesDirectionShort": {"description": "CR109 Amendment G. The sell-to-open side of the direction toggle. Market term \u2014 keep the English word where the local market uses it. NEW key. retranslate:[ar,ms]"},
    "gamesShortFeeNote": "Shorting costs 0.3% to open \u2014 three times the usual 0.1%.",
    "@gamesShortFeeNote": {"description": "CR109 Amendment G. The short-open fee, stated before the size is picked rather than on the confirm card alone. Rate set by Saiful 2026-08-11. If SHORT_FEE_BPS or FEE_BPS is retuned in games_scoring.py, THIS STRING MUST CHANGE TOO. NEW key. retranslate:[ar,ms]"},
    "gamesShortRiskNote": "A short can lose more than it ties up. There is no floor.",
    "@gamesShortRiskNote": {"description": "CR109 Amendment G. The one thing about a short that is not true of any other position in the app. Stated plainly, once, on the ticket. A statement of the mechanic, not advice. NEW key. retranslate:[ar,ms]"},
    "gamesShortBadge": "SHORT",
    "@gamesShortBadge": {"description": "CR109 Amendment G. Marker on a short position row, so a player scrolling past the section heading can still tell which way the position points. NEW key. retranslate:[ar,ms]"},
    "gamesRunShortsHeading": "SHORTS",
    "@gamesRunShortsHeading": {"description": "CR109 Amendment G. Heading of the short-positions section on the run screen, separate from POSITIONS because the P&L runs the other way. NEW key. retranslate:[ar,ms]"},
    "gamesRunShortSub": "{shares} shares shorted at {price}",
    "@gamesRunShortSub": {"description": "CR109 Amendment G. Sub-line on a short position row \u2014 the size and the price it was sold at. NEW key. retranslate:[ar,ms]", "placeholders": {"shares": {"type": "String", "example": "10.0000"}, "price": {"type": "String", "example": "212.44"}}},
    "gamesCoverCta": "COVER",
    "@gamesCoverCta": {"description": "CR109 Amendment G. Action on a short position row that opens the ticket in cover mode. The market term for buying a short back. NEW key. retranslate:[ar,ms]"},
    "gamesCoverTitle": "Cover {ticker}",
    "@gamesCoverTitle": {"description": "CR109 Amendment G. Header of the ticket when it opens in cover mode. NEW key. retranslate:[ar,ms]", "placeholders": {"ticker": {"type": "String", "example": "AAPL"}}},
    "gamesCoverShortOf": "You are short {shares} shares",
    "@gamesCoverShortOf": {"description": "CR109 Amendment G. The position being covered, shown above the confirm card. NEW key. retranslate:[ar,ms]", "placeholders": {"shares": {"type": "String", "example": "10.0000"}}},
    "gamesCoverWholeOnlyNote": "A cover buys the whole position back. There is no partial cover.",
    "@gamesCoverWholeOnlyNote": {"description": "CR109 Amendment G. Why the cover ticket has no size step. Without it the missing step reads as a bug rather than as the rule it is. NEW key. retranslate:[ar,ms]"},
    "gamesDuelHeading": "DUEL",
    "@gamesDuelHeading": {"description": "CR109 slice 3b. Heading of the head-to-head card on the run screen. NEW key. retranslate:[ar,ms]"},
    "gamesDuelFirstRunHeading": "YOUR FIRST RUN",
    "@gamesDuelFirstRunHeading": {"description": "CR109 slice 3b. Heading when the duel is the first-run pairing against the Index Desk \u2014 the framing is 'you versus the market', not 'a duel', because the player has no duel history to frame it against yet. NEW key. retranslate:[ar,ms]"},
    "gamesDuelVersus": "You vs {handle}",
    "@gamesDuelVersus": {"description": "CR109 slice 3b. Names the opponent. \u00a711.1: naming one opponent is what makes a thin field feel like a contest. NEW key. retranslate:[ar,ms]", "placeholders": {"handle": {"type": "String", "example": "VECTOR_11"}}},
    "gamesDuelAhead": "You are {pct}% ahead",
    "@gamesDuelAhead": {"description": "CR109 slice 3b. The gap, in percentage points of time-weighted return \u2014 never AMI Cash (\u00a76.1 forbids rendering another entrant's currency). NEW key. retranslate:[ar,ms]", "placeholders": {"pct": {"type": "String", "example": "1.10"}}},
    "gamesDuelBehind": "You are {pct}% behind",
    "@gamesDuelBehind": {"description": "CR109 slice 3b. The mirror of gamesDuelAhead. Stated plainly \u2014 no softening, no encouragement; the brand voice is analyst-to-analyst. NEW key. retranslate:[ar,ms]", "placeholders": {"pct": {"type": "String", "example": "1.10"}}},
    "gamesDuelLevel": "Dead level",
    "@gamesDuelLevel": {"description": "CR109 slice 3b. Both sides measured and equal. DISTINCT from gamesDuelNotStarted \u2014 a known tie is not the same as an unknown gap. NEW key. retranslate:[ar,ms]"},
    "gamesDuelNotStarted": "No closes yet \u2014 the gap is not measurable until both books have a close.",
    "@gamesDuelNotStarted": {"description": "CR109 slice 3b. Either side unmeasured. Says the gap is UNKNOWN rather than drawing it as level, which is the null-vs-zero rule this feature keeps producing instances of. NEW key. retranslate:[ar,ms]"},
    "gamesDuelAtStake": "{points} pts",
    "@gamesDuelAtStake": {"description": "CR109 slice 3b. What a live duel is playing for. Symmetric \u2014 the winner gains what the loser is debited \u2014 so one number serves both sides. NEW key. retranslate:[ar,ms]", "placeholders": {"points": {"type": "int", "example": "10"}}},
    "gamesDuelDaysLeft": "{days} days left",
    "@gamesDuelDaysLeft": {"description": "CR109 slice 3b. The clock, on the duel card. NEW key. retranslate:[ar,ms]", "placeholders": {"days": {"type": "int", "example": "3"}}},
    "gamesDuelWon": "You won. +{points} career points.",
    "@gamesDuelWon": {"description": "CR109 slice 3b. Settled duel, this player won. NEW key. retranslate:[ar,ms]", "placeholders": {"points": {"type": "int", "example": "10"}}},
    "gamesDuelLost": "You lost. \u2212{points} career points.",
    "@gamesDuelLost": {"description": "CR109 slice 3b. Settled duel, this player lost. Uses a MINUS SIGN (U+2212), not a hyphen. NEW key. retranslate:[ar,ms]", "placeholders": {"points": {"type": "int", "example": "10"}}},
    "gamesDuelDraw": "A draw. No points either way.",
    "@gamesDuelDraw": {"description": "CR109 slice 3b. Both returns equal to four decimal places. A real outcome, reported as one. NEW key. retranslate:[ar,ms]"},
    "gamesDuelVoid": "Void \u2014 one side\u2019s run could not be measured. No points either way.",
    "@gamesDuelVoid": {"description": "CR109 slice 3b. A duel with a voided side. Stated, never silently drawn as a draw \u2014 unmeasurable is a different thing from tied, and CR040 requires the difference be visible. NEW key. retranslate:[ar,ms]"},
    "gamesCloseDuelBeatTheMarket": "You beat the market.",
    "@gamesCloseDuelBeatTheMarket": {"description": "CR109 slice 3b. Beat 2 of the Close on a FIRST run won against the Index Desk. Deliberately not 'you beat INDEX_DESK' \u2014 a beginner has no duel history to read a handle against, and 'beat the market' needs no tutorial. NEW key. retranslate:[ar,ms]"},
    "gamesCloseDuelMarketWon": "The market beat you.",
    "@gamesCloseDuelMarketWon": {"description": "CR109 slice 3b. The mirror. Stated plainly \u2014 both outcomes are stories, and softening the loss would make the win mean less. NEW key. retranslate:[ar,ms]"},
    "gamesCloseDuelWon": "You beat {handle}.",
    "@gamesCloseDuelWon": {"description": "CR109 slice 3b. Beat 2 on a won duel against a named human opponent. NEW key. retranslate:[ar,ms]", "placeholders": {"handle": {"type": "String", "example": "VECTOR_11"}}},
    "gamesCloseDuelLost": "{handle} beat you.",
    "@gamesCloseDuelLost": {"description": "CR109 slice 3b. Beat 2 on a lost duel. The opponent is the subject \u2014 they did something, rather than the player having failed at something. NEW key. retranslate:[ar,ms]", "placeholders": {"handle": {"type": "String", "example": "VECTOR_11"}}},
    "gamesCloseDuelDrew": "Dead level with {handle}.",
    "@gamesCloseDuelDrew": {"description": "CR109 slice 3b. Both returns equal to four decimal places. A real outcome, reported as one. NEW key. retranslate:[ar,ms]", "placeholders": {"handle": {"type": "String", "example": "VECTOR_11"}}},
    "gamesCloseDuelMargin": "By {pct}.",
    "@gamesCloseDuelMargin": {"description": "CR109 slice 3b. The margin, in percentage points of time-weighted return. Magnitude only \u2014 the sign is already carried by the headline above, and repeating it would read as a double negative on a loss. NEW key. retranslate:[ar,ms]", "placeholders": {"pct": {"type": "String", "example": "3.0%"}}},
    "gamesCloseDuelPointsWon": "+{points} career points.",
    "@gamesCloseDuelPointsWon": {"description": "CR109 slice 3b. What the duel win was worth. NEW key. retranslate:[ar,ms]", "placeholders": {"points": {"type": "int", "example": "10"}}},
    "gamesCloseDuelPointsLost": "\u2212{points} career points.",
    "@gamesCloseDuelPointsLost": {"description": "CR109 slice 3b. What the duel loss cost. MINUS SIGN (U+2212), not a hyphen. NEW key. retranslate:[ar,ms]", "placeholders": {"points": {"type": "int", "example": "10"}}}
