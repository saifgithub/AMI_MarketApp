# Per-environment canonical env files — Mac holds the source of truth,
# /promote-to-<env> ships the matching file to the target host. Never
# commit the populated form; only the *.example shape is tracked. See
# infra/README.md for the model.
infra/alpha.env
infra/beta.env
infra/prod.env

# IDE
.idea/
.vscode/
*.swp
*.swo

# Claude Code session state
.claude/active-track

# OS
.DS_Store
Thumbs.db

# Terraform
infra/**/*.tfstate
infra/**/*.tfstate.backup
infra/**/.terraform/
infra/**/terraform.tfvars

# Build artifacts
*.log
*.pid

# Local SQLite (solo-dev fallback + alembic placeholder)
backend/.local.db
backend/.alembic-placeholder.db

# Local model caches (TradingAgents)
.tradingagents/
~/.tradingagents/

# Claude Code sibling worktrees (each agent session can spawn its own)
.claude/worktrees/
# Patches salvaged from pruned worktrees (kept locally for ref, not shipped)
.claude/worktree-salvage/

# TestFlight upload artifacts (Xcode Organizer export) — local-only
Apple_Store/

# Local Claude tooling memory — host-side. CR097: track ONLY the sm-checkpoint archives
# (the durable cold-start anchor that replaced the retired HANDOVER docs); memory.sqlite,
# .DS_Store, and everything else under .deliveryos/ stay host-side and uncommitted.
.deliveryos/*
!.deliveryos/checkpoint_history/
.deliveryos/checkpoint_history/*
!.deliveryos/checkpoint_history/*.md

# CR082 — exported tester/user contact CSVs. Personal data, local-only, never committed.
contacts_*.csv

# CR061 — ephemeral per-lane live-handle files (worker session ids)
orchestration/dispatch/handles/

# CR080 — Appium UAT harness: real credentials + local venv/report artifacts.
# Real values live only in test_data/.env on melehost, never here.
qa/appium/test_data/.env
qa/appium/.venv/
qa/appium/_report/
docs/forward_planning/CR106_room_result_visual_summary/prototype/.fonts/
