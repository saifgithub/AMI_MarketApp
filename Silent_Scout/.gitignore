# Silent_Scout — research workspace ignore rules

# Weights, checkpoints, adapters — always live outside the repo
03_training/runs/
**/checkpoints/
**/*.safetensors
**/*.bin
**/*.pt
**/*.pth
**/*.gguf

# Raw / processed dataset blobs — pull on demand, never commit
02_data/raw/
02_data/processed/
**/*.parquet
**/*.arrow
**/cache/
**/.cache/

# Eval result dumps (keep only summary markdown)
04_eval/results/
04_eval/**/runs/
04_eval/**/*.jsonl
!04_eval/**/sample_*.jsonl

# Python / venv junk
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Frozen pip snapshots (keep last good only)
00_environment/frozen_*.txt
!00_environment/frozen_LATEST.txt

# Editor / OS junk
.DS_Store
.idea/
.vscode/
*.swp

# Secrets — never
.env
.env.*
**/credentials.json
**/api_keys.txt
