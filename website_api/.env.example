# Website API — environment variables
# Copy to .env and fill in values before running.
# Convention: presence of a key turns a feature on; absent keys degrade
# gracefully so the site runs locally with no secrets (see app/core/config.py).

ENV=local

# Postgres database dedicated to website data — NOT the main ami_trade DB.
# Create with: CREATE DATABASE ami_website;  (tests use a sqlite tempfile instead)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ami_website

# Comma-separated allow-list of origins that may call the API (CORS).
CORS_ORIGINS=https://www.agenticmarketintel.ai,https://agenticmarketintel.ai

# ── On-prem model (LAN) for the Concierge chatbot ──────────────────────────
# Unset → concierge/contact fall back to scripted KB replies (degrade loudly).
VLLM_BASE_URL=http://192.168.20.74:8000
VLLM_MODEL=ami-llm
VLLM_API_KEY=

# ── Transactional email (Resend HTTP API) ──────────────────────────────────
# Unset RESEND_API_KEY → email sends are logged + skipped (local/dev).
RESEND_API_KEY=
RESEND_FROM=AMI <support.ai@agenticmarketintel.ai>
# Where contact escalations + data requests are forwarded (Saiful's inbox).
NOTIFY_EMAIL=

# ── Bot protection (Cloudflare Turnstile) ──────────────────────────────────
# Unset → captcha verification is bypassed (local/dev).
TURNSTILE_SECRET=
