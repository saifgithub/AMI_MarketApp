# Website API — environment variables
# Copy to .env and fill in values before running.

ENV=local

# Postgres database dedicated to website data — NOT the main ami_trade DB.
# Create with: CREATE DATABASE ami_website;
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ami_website

# Only this origin may call the API. Set to the live domain in prod.
CORS_ORIGIN=https://www.agenticmarketintel.com
