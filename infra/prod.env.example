# AMI Trade — Prod environment env file (shape only). STUB.
#
# Prod is the App Store / Play Store launch (MVP). This file gets
# populated alongside M1-M12 in docs/10_delivery/project_plan.md.
# Copy to `infra/prod.env` (gitignored) and fill in once the providers
# are real; /promote-to-prod will ship it then. Mac stays canonical.
#
# Most slots here are placeholders until the matching M-item lands.

# ── Cloud LLM provider (cutover from Beta) ──────────────────────────────
# ANTHROPIC_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=

# ── Supabase (Prod project) ─────────────────────────────────────────────
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# ── RevenueCat (payments — M1) ──────────────────────────────────────────
# REVENUECAT_SECRET_KEY=

# ── OneSignal (push — production APNs cert per M6) ──────────────────────
# ONESIGNAL_APP_ID=
# ONESIGNAL_REST_API_KEY=

# ── Resend (transactional email) ────────────────────────────────────────
# RESEND_API_KEY=

# ── Sentry (Prod project) ───────────────────────────────────────────────
# SENTRY_DSN=

# ── PostHog (analytics — M7) ────────────────────────────────────────────
# POSTHOG_API_KEY=

# ── Market data ─────────────────────────────────────────────────────────
USE_REAL_MARKET_DATA=true
