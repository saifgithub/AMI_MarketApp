# A9 — Postgres backup oneshot. Triggered by ami-trade-pg-backup.timer.

[Unit]
Description=AMI Trade Postgres backup (pg_dump → /var/backups/ami-trade)
After=network-online.target docker.service

[Service]
Type=oneshot
User=ami
Group=ami
EnvironmentFile=-/etc/ami-trade-backup.env
ExecStart=/opt/ami-trade/infra/backups/pg-backup.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ami-trade-pg-backup
