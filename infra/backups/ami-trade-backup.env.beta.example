# CR267 WP-44 — /etc/ami-trade-backup.env for the BETA host (shape only, no secrets).
# Install it root-owned, mode 0640, group ami, then fill in every value marked <...>.
# NEVER commit the filled-in file. Read by pg-backup.sh, pg-restore-drill.sh and the
# systemd units (EnvironmentFile).
# Guide: docs/forward_planning/CR267_beta_programme/wp44_backups_alerts.md

# --- Postgres: the compose stack's container (same password as POSTGRES_PASSWORD in the Beta .env).
# The user `ami` must be in the docker group for PG_DOCKER_CONTAINER to work.
PG_DOCKER_CONTAINER=ami_postgres
PG_USER=postgres
PG_DB=ami_trade
PGPASSWORD=<POSTGRES_PASSWORD from the Beta .env>

# --- Encryption. Keep a COPY of this passphrase in the password manager: without it every backup is unreadable.
# Create it with: umask 077; openssl rand -base64 32 > /etc/ami-trade-backup.pass
BACKUP_ENCRYPTION_PASSPHRASE_FILE=/etc/ami-trade-backup.pass

# --- Local copies (encrypted). The bucket holds the retention history, so keep few here.
BACKUP_DIR=/var/backups/ami-trade
RETENTION_DAYS=3

# --- Off-server copy: Cloudflare R2 (S3 API). Token = Object Read & Write, scoped to this one bucket.
BACKUP_REQUIRE_OFFSITE=1
BACKUP_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=<bucket name>
BACKUP_S3_PREFIX=pg
BACKUP_S3_ACCESS_KEY_ID=<R2 access key id>
BACKUP_S3_SECRET_ACCESS_KEY=<R2 secret access key>
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8

# --- Where a failed backup is reported (Slack/Discord/Mattermost-style incoming webhook)
BACKUP_ALERT_WEBHOOK_URL=<webhook URL>
