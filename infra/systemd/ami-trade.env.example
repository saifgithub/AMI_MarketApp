# AMI Trade backend env (A8) — install to /etc/ami-trade.env (mode 0640).
#
# This file is read by systemd via EnvironmentFile= in
# /etc/systemd/system/ami-trade-backend.service. Every line is KEY=VALUE
# (no `export`, no shell expansion, no inline comments after VALUE).
#
# Never check the real /etc/ami-trade.env into git. This is the template.

# ── Core ────────────────────────────────────────────────────────────────
AMI_ENV=prod
LOG_LEVEL=INFO

# ── Database ────────────────────────────────────────────────────────────
# Postgres on the same box (W8 stack). For Supabase later, swap the URL.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5434/ami_trade

# ── LLM (on-prem vLLM Gemma 4 31B by default; cloud provider for Beta) ─
VLLM_BASE_URL=http://192.168.20.74:8000
VLLM_MODEL=gemma-4-31b-it-nvfp4
# VLLM_API_KEY=                  # optional bearer if vLLM is auth-gated
# ANTHROPIC_API_KEY=             # fallback / Beta cutover

# ── Market data ─────────────────────────────────────────────────────────
USE_REAL_MARKET_DATA=true

# ── Auth / external services (Alpha will populate as items unblock) ────
# RESEND_API_KEY=                # A3 → A4/A5
# SENTRY_DSN=                    # A10
# ONESIGNAL_APP_ID=              # A15/A16
# ONESIGNAL_API_KEY=
# TTS_PROVIDER=azure             # A13/A14: azure | elevenlabs
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# ELEVENLABS_API_KEY=

# ── CORS / origins ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the API. The Cloudflare
# Tunnel hostname (A7) must appear here once the tunnel is live so the
# Flutter app can call us through it.
CORS_ORIGINS=https://api-alpha.example.com,capacitor://localhost,http://localhost

# ── Cloudflare Tunnel (A7) ──────────────────────────────────────────────
# The cloudflared connector itself reads its token from
# /etc/ami-trade-tunnel.env (separate file, mode 0600) — see
# infra/cloudflared/README.md. The backend doesn't talk to Cloudflare
# directly; we list the public hostname here only so it can be plumbed
# into the Flutter build via --dart-define=AMI_API_URL.
AMI_PUBLIC_API_URL=https://api-alpha.example.com
