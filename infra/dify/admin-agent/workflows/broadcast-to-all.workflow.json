     "code_language": "python3",
     "code": "def main(broadcast_id=None, sent_recipients=None, push_sent=None, status_counts=None):\n    lines = [\"SENT \u2014 broadcast dispatched.\", \"\"]\n    lines.append(\"- in-app: broadcast_id `{0}`, {1} recipients\".format(broadcast_id, sent_recipients))\n    if push_sent is None:\n        lines.append(\"- push: not requested\")\n    else:\n        lines.append(\"- push: {0} recipients, status_counts {1}\".format(push_sent, status_counts))\n    lines.append(\"\")\n    lines.append(\"Console: https://api-alpha.agenticmarketintel.ai/admin (MESSAGES tab)\")\n    return {\"text\": \"\\n\".join(lines)}\n",
     "outputs": {
