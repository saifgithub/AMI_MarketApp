     "code_language": "python3",
     "code": "def main(recipient_count=None, push_recipients=None, push_configured=None):\n    n = recipient_count if recipient_count is not None else \"?\"\n    if push_recipients is None:\n        tail = \"in-app {0} recipients (push not requested)\".format(n)\n    else:\n        pc = \"\" if push_configured else \" (push not configured)\"\n        tail = \"in-app {0} recipients, push {1} recipients{2}\".format(n, push_recipients, pc)\n    return {\"text\": \"ABORTED \u2014 nothing was sent. Preview counts: \" + tail + \". Re-run with confirm=SEND to send.\"}\n",
     "outputs": {
      "text": {
       "type": "string"
