# AMI Ops Dify stack — sanitized env template (CR200-R003 slice 1).
# Live on melehost at /home/saiful/ami-ops-dify/.env (mode 600, never committed).
# Generate every secret fresh — do NOT reuse values across stacks:
#   DIFY_SECRET_KEY / DIFY_SANDBOX_API_KEY / DIFY_PLUGIN_DAEMON_KEY /
#   DIFY_INNER_API_KEY / INIT_PASSWORD:  openssl rand -hex 32
#   DIFY_DB_PASSWORD / DIFY_REDIS_PASSWORD / DIFY_AGENT_API_TOKEN: openssl rand -hex 24
#   DIFY_AGENT_SERVER_SECRET_KEY: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
#     (must be unpadded base64url decoding to exactly 32 bytes — agent_backend rejects otherwise)

COMPOSE_PROJECT_NAME=ami-ops-dify

# melehost Tailscale IP — nginx binds ONLY here, never 0.0.0.0
AMIOPS_BIND_IP=
# tailnet-only port for this stack
AMIOPS_NGINX_PORT=8081

# absolute host path for all bind mounts (app storage, db, redis, sandbox, plugin_daemon)
AMIOPS_DATA_DIR=/home/saiful/ami-ops-dify/data

DIFY_SECRET_KEY=
DIFY_DB_PASSWORD=
DIFY_REDIS_PASSWORD=
DIFY_SANDBOX_API_KEY=
DIFY_PLUGIN_DAEMON_KEY=
DIFY_INNER_API_KEY=
DIFY_AGENT_API_TOKEN=
DIFY_AGENT_SERVER_SECRET_KEY=
INIT_PASSWORD=
