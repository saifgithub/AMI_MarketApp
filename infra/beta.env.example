# AMI Trade — Beta environment env file (shape only). STUB.
#
# Beta is GCP Cloud Run + Supabase + cloud LLM. This file gets populated
# when those provision (B1, B4, B7 in docs/10_delivery/project_plan.md).
# Copy to `infra/beta.env` (gitignored) and fill in once the providers
# are real; /promote-to-beta will ship it then. Mac stays canonical.
#
# Most slots here are placeholders until the matching B-item lands.

# ── Cloud LLM provider ──────────────────────────────────────────────────
# B7: pick Anthropic, Vertex Gemini, or both. Today: vLLM serves Alpha;
# Beta is the cutover. Leave commented until decided.
# ANTHROPIC_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=

# ── Supabase ────────────────────────────────────────────────────────────
# B4 + B5: drop in once the project is provisioned.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# ── Resend (email confirmation) ─────────────────────────────────────────
# A3 in Alpha — moves to Beta with the same key when Supabase auth
# takes over.
# RESEND_API_KEY=

# ── Sentry ──────────────────────────────────────────────────────────────
# Same project as Alpha or a separate Beta project — Saiful decides.
# SENTRY_DSN=

# ── Market data ─────────────────────────────────────────────────────────
USE_REAL_MARKET_DATA=true
