# AMI Trade -- Beta environment env file (shape only, no secrets).  CR279 / CR267 WP-41.
#
# Copy to `infra/beta.env` (gitignored), fill every [REQUIRED] key, and ship it to the
# Beta host's ~/ami_trade/.env via /promote-to-beta. The Mac is canonical.
# Beta runs the SAME docker-compose.yml as Alpha (service `api-alpha`, container
# `ami_api_alpha`) on its own host with its own database; the environment is selected by
# the AMI_ENV setting below, not by a different service.
#
# Conventions
#   [REQUIRED] keys are uncommented. Secrets are left EMPTY on purpose: the app refuses
#              to boot on an empty SECRET_KEY, and compose refuses to parse without the
#              datastore passwords, so a copied-and-forgotten file fails loudly.
#   [OPTIONAL] keys are commented out and show compose's default. Uncomment to override.
#   NEVER copy a value from infra/alpha.env: Beta has its own keys, its own database and
#   its own tunnel. Anything shared between the two environments is a leak path.
#
# Beta boot refusals (backend/app/core/beta_boot.py) -- ENV=beta will not start if:
#   - VLLM_BASE_URL / VLLM_FALLBACK_BASE_URL / GLM_BASE_URL is a private, LAN, loopback
#     or Tailscale (100.64/10) address, or VLLM_BASE_URL is empty;
#   - ANTHROPIC_API_KEY, KIMI_API_KEY or GOOGLE_AI_API_KEY is set;
#   - LLM_PROVIDER_ALLOWLIST is empty or names anthropic / kimi / gemini (CR281);
#   - LLM_DAILY_SPEND_CEILING_USD is unset or 0, or a served model is missing from
#     LLM_PRICES_JSON;
#   - SENTRY_DSN is empty (WP-44);
#   - OUTPUT_GUARD_MODE is not enforce (CR271 / WP-13);
#   - INSERT_TRIPWIRE_MODE is off (ISS001);
#   - ANDROID_PLAY_STORE_URL is empty or names the personal Alpha package (DEF511);
#   - ONBOARDING_AGE_GATE_ENFORCED is false;
#   - ACCOUNT_ERASURE_MODE=archive without ACCOUNT_ARCHIVE_COUNSEL_APPROVED=true;
#   - SECRET_KEY is the dev default or under 32 characters.


# ======================================================================
# Identity and secrets
# ======================================================================
# [REQUIRED] Selects the Beta posture. compose refuses to start if unset; the app then refuses to boot unless the CR279 Beta checks pass (backend/app/core/beta_boot.py).
AMI_ENV=beta

# [REQUIRED] Fresh per-environment HMAC key for auth tokens. NEVER reuse Alpha's. Generate: openssl rand -hex 32. Boot refuses empty, default, or under 32 chars.
SECRET_KEY=

# [REQUIRED] Static bearer for /v1/admin/* and operator/UAT traffic. Fresh value, not Alpha's. Generate: openssl rand -hex 32. Empty disables admin.
ADMIN_SECRET=

# [OPTIONAL] Cloudflare Access team URL (https://<team>.cloudflareaccess.com) for the management console. Set BOTH this and CF_ACCESS_AUD or neither.
# CF_ACCESS_TEAM_DOMAIN=

# [OPTIONAL] Cloudflare Access application Audience tag for the management console. Set with CF_ACCESS_TEAM_DOMAIN.
# CF_ACCESS_AUD=

# [OPTIONAL] Build arg baked into the image by the promotion script (deploy identity, CR175). Do not set by hand.
# GIT_SHA=unset

# [OPTIONAL] Build arg baked into the image by the promotion script (the alpha-* tag being promoted). Do not set by hand.
# ALPHA_TAG=unset

# [OPTIONAL] Scaffold Bearer token lifetime in days.
# AUTH_TOKEN_TTL_DAYS=30

# [OPTIONAL] Days past expiry a token may still prove account ownership on /v1/auth/anon.
# AUTH_REBOOTSTRAP_GRACE_DAYS=180

# [OPTIONAL] Last date a pre-CR125 token may prove ownership. Beta starts empty, so no legacy tokens exist; the default is harmless.
# AUTH_LEGACY_REBOOTSTRAP_UNTIL=2027-02-07

# [REQUIRED] JSON list of allowed web origins. Compose's default is ALPHA's hostname, so Beta sets its own (single-quoted so compose keeps the JSON literal).
CORS_ORIGINS='["https://api-beta.agenticmarketintel.ai"]'


# ======================================================================
# Datastores (compose refuses to parse without the passwords)
# ======================================================================
# [REQUIRED] Postgres password; compose refuses to parse without it. Read at first initdb only. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# [OPTIONAL] Postgres role name for the app database.
# POSTGRES_USER=postgres

# [REQUIRED] Redis password; compose refuses to parse without it. Generate like POSTGRES_PASSWORD.
REDIS_PASSWORD=

# [REQUIRED] compose refuses to parse without it (the api-website service is declared in the same file). The marketing site is not run on Beta; any strong value.
WEBSITE_DB_PASSWORD=

# [OPTIONAL] Admin secret for the website waitlist export (WP-51). The marketing site is not run on Beta; leave empty.
# WEBSITE_ADMIN_SECRET=


# ======================================================================
# Cloudflare Tunnel
# ======================================================================
# [REQUIRED] Cloudflare Tunnel connector token for api-beta.agenticmarketintel.ai (a NEW tunnel, not Alpha's). Empty makes cloudflared fail loudly.
CF_TUNNEL_TOKEN=

# [OPTIONAL] Tunnel transport: quic | http2 | auto. http2 sidesteps UDP loss (DEF070); revisit on the Beta host.
# CF_TUNNEL_PROTOCOL=http2


# ======================================================================
# LLM -- hosted primary and backup (DeepInfra), spend ceiling, output guard
# ======================================================================
# [REQUIRED] CR281 provider allow-list: the only gateway slots Beta may register, whatever keys are present. Boot refuses empty, an unknown slot, or anthropic/kimi/gemini.
LLM_PROVIDER_ALLOWLIST=vllm,vllm_fallback

# [REQUIRED] PRIMARY LLM: DeepInfra, `https://api.deepinfra.com/v1/openai` (the gateway normalises it; the bare host and a trailing /v1 work too). Must be public https; private/LAN addresses are refused at boot.
VLLM_BASE_URL=https://api.deepinfra.com/v1/openai

# [REQUIRED] PRIMARY model id as DeepInfra serves it (CR267 S2 ruling). Must also be priced in LLM_PRICES_JSON.
VLLM_MODEL=deepseek-ai/DeepSeek-V4-Flash

# [REQUIRED] DeepInfra API key (a Beta-only key with its own spend limit). Never Alpha's.
VLLM_API_KEY=

# [REQUIRED] Provider dialect for the primary slot. `openai` = hosted OpenAI-compatible API; `vllm` would send on-prem-only request fields.
VLLM_KIND=openai

# [REQUIRED] BACKUP LLM host: a second DeepInfra model (CR267 S3a.1). Public https only; the Room restarts wholly on it if the primary fails.
VLLM_FALLBACK_BASE_URL=https://api.deepinfra.com/v1/openai

# [REQUIRED] BACKUP model id: Ling-3.0-flash on DeepInfra (Saiful, 2026-11-19). Priced in LLM_PRICES_JSON.
VLLM_FALLBACK_MODEL=inclusionAI/Ling-3.0-flash

# [REQUIRED] API key for the backup slot (the same Beta DeepInfra key is fine; spend is counted together).
VLLM_FALLBACK_API_KEY=

# [REQUIRED] Provider dialect for the backup slot.
VLLM_FALLBACK_KIND=openai

# [REQUIRED] CR281 JSON merged into every request body for the backup slot: Ling-3.0-flash on DeepInfra runs with thinking ON unless this turns it off (WP-10 scorecard §1b). Single-quoted so compose keeps the JSON literal. Protected fields (model, messages, max_tokens, response_format, ...) are refused at boot.
VLLM_FALLBACK_EXTRA_BODY_JSON='{"chat_template_kwargs":{"enable_thinking":false}}'

# [REQUIRED] USD per 1M input/output tokens per served model id (CR270). Single-quoted so compose keeps the JSON literal. Boot refuses a primary/backup model missing here.
LLM_PRICES_JSON='{"deepseek-ai/DeepSeek-V4-Flash":{"in":0.09,"out":0.18},"inclusionAI/Ling-3.0-flash":{"in":0.06,"out":0.18}}'

# [REQUIRED] Daily LLM spend ceiling in USD, UTC day, primary + backup together (CR270, S11 3a: $10/day on Beta). Boot refuses unset or 0.
LLM_DAILY_SPEND_CEILING_USD=10

# [REQUIRED] Beta testers run Rooms without being charged credits (CR278); the advertised room_cost reads 0. Alpha keeps false.
BETA_FREE_CREDITS=true

# [REQUIRED] Bursa Malaysia (.KL tickers, MYR book) master switch (CR282). Beta stays false until counsel answers the CMSA 2007 advice question.
MARKET_BURSA_ENABLED=false

# [OPTIONAL] Bursa Room discount-rate inputs (CR282 lane E): 10-year MGS yield and the Malaysian equity risk premium, in percent. Dated defaults; only read for `.KL` Rooms.
# WACC_MY_RISK_FREE_PCT=3.9
# [OPTIONAL] See WACC_MY_RISK_FREE_PCT.
# WACC_MY_ERP_PCT=6.0
# [OPTIONAL] Malaysian headline CPI line on a Bursa Room's sheet, from OpenDOSM (CR282 lane E). Off: the sheet says the feed is not enabled.
# OPENDOSM_CPI_ENABLED=false
# [OPTIONAL] Malay Mail Money RSS as a Bursa Room's second news source (CR282 lane E2): headline, link and date only, attributed Malay Mail. Off: the sheet says the feed is not enabled. Permission from Malay Mail/Bernama is being requested; keep false until it is in hand.
# MY_NEWS_RSS_ENABLED=false
# [OPTIONAL] Weekly read of Bursa Malaysia's public PN17/GN3 list for the Bursa fact-sheet status line (CR286). One plain request per run from a host cron; off: the refresh script exits non-zero and the sheet line reads "unavailable". Bursa's terms restrict automated copying: keep false until counsel answers.
# BURSA_PN17_REFRESH_ENABLED=false

# [OPTIONAL] Device-UAT 503 fault switch (CR239 WP-38). Alpha-only: Beta ignores it and logs uat_fault_inject_refused. Leave empty.
# UAT_FAULT_INJECT=

# [REQUIRED] Output text guard (CR271): off | log | enforce. Beta runs `enforce` (WP-13 replay 2026-11-20): personal-advice or abusive text is replaced with a labelled AMI notice, an overlong turn is trimmed. Boot refuses anything else on Beta.
OUTPUT_GUARD_MODE=enforce

# [OPTIONAL] INSERT tripwire on the app engine (ISS001): log | raise (off is refused on Beta). `log` records an unsanctioned INSERT into a unique-keyed table at ERROR and runs it; `raise` refuses it.
# INSERT_TRIPWIRE_MODE=log

# [OPTIONAL] Word cap for one agent turn (CR271 runaway_length). Default 1680 = p99.9 of Room turns (1,488 words) plus headroom, 3x p99; confirmed on the 2026-11-20 replay of 124k stored turns.
# OUTPUT_GUARD_MAX_TURN_WORDS=1680

# [OPTIONAL] Pin one provider by name (testing only). Leave empty on Beta.
# LLM_FORCE_PROVIDER=

# [OPTIONAL] Raise tiny max_tokens to this floor. 0 = off. On-prem reasoning-model workaround; keep 0 for hosted models.
# VLLM_MAX_TOKENS_FLOOR=0

# [OPTIONAL] Send the reasoning-mode flag to the primary. Only meaningful for kind=vllm.
# VLLM_ENABLE_THINKING=false

# [OPTIONAL] Thinking-token cap when thinking is on. 0 = off.
# VLLM_THINKING_MAX_TOKENS=0

# [OPTIONAL] Poll the vLLM host /metrics for cache counters. A hosted API has no /metrics; set 0 to disable.
# VLLM_METRICS_SAMPLE_INTERVAL_SECONDS=0

# [OPTIONAL] Per-request LLM timeout in seconds.
# VLLM_REQUEST_TIMEOUT_S=360.0

# [OPTIONAL] Retries on transient provider errors before failing over to the backup.
# LLM_TRANSIENT_RETRIES=3

# [OPTIONAL] Base back-off between those retries, seconds.
# LLM_RETRY_BACKOFF_S=1.0

# [OPTIONAL] Sampling temperature for desk agents. Empty = provider default (CR269).
# LLM_DESK_TEMPERATURE=

# [OPTIONAL] Sampling temperature for the judge; 0 = deterministic.
# LLM_JUDGE_TEMPERATURE=0.0

# [OPTIONAL] Per-agent timeout inside a Room, seconds.
# ROOM_AGENT_TIMEOUT_S=180.0

# [OPTIONAL] Typewriter pacing, minimum ms per character (CR277).
# ROOM_CHAR_DELAY_MIN_MS=1.5

# [OPTIONAL] Typewriter pacing, maximum ms per character (CR277).
# ROOM_CHAR_DELAY_MAX_MS=3.5

# [OPTIONAL] Typewriter pacing cap per turn, seconds.
# ROOM_TURN_PACE_CAP_S=4.0

# [OPTIONAL] Typewriter pacing cap per Room, seconds.
# ROOM_PACE_CAP_S=40.0


# ======================================================================
# LLM vendors Beta must NOT use (leave empty; a set Anthropic/Kimi/Gemini key or a private GLM address refuses boot)
# ======================================================================
# [OPTIONAL] MUST STAY EMPTY on Beta: no Anthropic keys (Saiful, 2026-11-19). Boot refuses if set.
# ANTHROPIC_API_KEY=

# [OPTIONAL] MUST STAY EMPTY on Beta: no Kimi keys (Saiful, 2026-11-19). Boot refuses if set.
# KIMI_API_KEY=

# [OPTIONAL] MUST STAY EMPTY on Beta: no Gemini keys (Saiful, 2026-11-19). Boot refuses if set.
# GOOGLE_AI_API_KEY=

# [OPTIONAL] Kimi endpoint; inert while KIMI_API_KEY is empty. Leave unset.
# KIMI_BASE_URL=https://api.kimi.com/coding

# [OPTIONAL] Kimi model id; inert while KIMI_API_KEY is empty. Leave unset.
# KIMI_MODEL=kimi-for-coding

# [OPTIONAL] Kimi token floor; inert while KIMI_API_KEY is empty.
# KIMI_MAX_TOKENS_FLOOR=8000

# [OPTIONAL] Self-hosted GLM slot (a Tailscale host on Alpha). MUST STAY EMPTY on Beta: private addresses are refused at boot.
# GLM_BASE_URL=

# [OPTIONAL] GLM model id; inert while GLM_BASE_URL is empty.
# GLM_MODEL=LibertAIDAI/GLM-5.3-Flash-NVFP4

# [OPTIONAL] GLM key; inert while GLM_BASE_URL is empty.
# GLM_API_KEY=

# [OPTIONAL] GLM token floor; inert while GLM_BASE_URL is empty.
# GLM_MAX_TOKENS_FLOOR=12000

# [OPTIONAL] Unused on Beta. Leave empty: Beta's only LLM vendor is the DeepInfra pair above.
# OPENROUTER_API_KEY=

# [OPTIONAL] Unused on Beta. Leave empty: Beta's only LLM vendor is the DeepInfra pair above.
# OPENAI_API_KEY=

# [OPTIONAL] Unused on Beta. Leave empty: Beta's only LLM vendor is the DeepInfra pair above.
# DEEPSEEK_API_KEY=

# [OPTIONAL] Unused on Beta. Leave empty: Beta's only LLM vendor is the DeepInfra pair above.
# DASHSCOPE_API_KEY=

# [OPTIONAL] CR281 JSON object merged into every request body for this slot (default: nothing). Ling-3.0-flash on DeepInfra needs thinking off: {"chat_template_kwargs":{"enable_thinking":false}}. Single-quote it. Protected fields (model, messages, max_tokens, response_format, ...) are refused at boot.
# VLLM_EXTRA_BODY_JSON=

# [OPTIONAL] CR281 per-slot extra request-body JSON for the glm slot; empty merges nothing.
# GLM_EXTRA_BODY_JSON=

# [OPTIONAL] CR281 per-slot extra request-body JSON for the kimi slot; empty merges nothing.
# KIMI_EXTRA_BODY_JSON=

# [OPTIONAL] CR281 per-slot extra request-body JSON for the deepseek slot; empty merges nothing.
# DEEPSEEK_EXTRA_BODY_JSON=

# [OPTIONAL] CR281 per-slot extra request-body JSON for the qwen slot; empty merges nothing.
# QWEN_EXTRA_BODY_JSON=

# [OPTIONAL] CR281 per-slot extra request-body JSON for the gemini slot; empty merges nothing.
# GEMINI_EXTRA_BODY_JSON=

# [OPTIONAL] CR281 endpoint/model for an unused slot; inert on Beta (LLM_PROVIDER_ALLOWLIST excludes it). Leave unset.
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# [OPTIONAL] CR281 endpoint/model for an unused slot; inert on Beta (LLM_PROVIDER_ALLOWLIST excludes it). Leave unset.
# DEEPSEEK_MODEL=deepseek-chat

# [OPTIONAL] CR281 endpoint/model for an unused slot; inert on Beta (LLM_PROVIDER_ALLOWLIST excludes it). Leave unset.
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode

# [OPTIONAL] CR281 endpoint/model for an unused slot; inert on Beta (LLM_PROVIDER_ALLOWLIST excludes it). Leave unset.
# QWEN_MODEL=qwen-flash

# [OPTIONAL] CR281 endpoint/model for an unused slot; inert on Beta (LLM_PROVIDER_ALLOWLIST excludes it). Leave unset.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# [OPTIONAL] CR281 endpoint/model for an unused slot; inert on Beta (LLM_PROVIDER_ALLOWLIST excludes it). Leave unset.
# GEMINI_MODEL=gemini-2.5-flash


# ======================================================================
# Market data, news, social, screens, simulator
# ======================================================================
# [REQUIRED] Real Yahoo prices; false falls back to a deterministic mock walk, which testers must never see.
USE_REAL_MARKET_DATA=true

# [REQUIRED] Alpha Vantage key for the news merge (CR023). A Beta-specific key; mind the free-tier quota (DEF492). Empty = news feed dark.
ALPHA_VANTAGE_API_KEY=

# [OPTIONAL] Shared per-ticker news cache (DEF492): seconds a fetched feed is reused.
# ALPHA_VANTAGE_NEWS_CACHE_TTL_SECONDS=1800.0

# [OPTIONAL] Seconds an empty or refused news fetch is remembered before retrying (DEF492).
# ALPHA_VANTAGE_NEWS_NEGATIVE_TTL_SECONDS=900.0

# [REQUIRED] Adanos social-sentiment key (CR024). Empty = social feed dark, loudly.
ADANOS_API_KEY=

# [OPTIONAL] Second Adanos key (250 calls/month each); used when the first is exhausted.
# ADANOS_API_KEY_SECONDARY=

# [OPTIONAL] Days a social-feed lookup is cached.
# SOCIAL_CACHE_TTL_DAYS=7

# [OPTIONAL] Ticker used for the risk-free rate.
# RISK_FREE_RATE_TICKER=^IRX

# [OPTIONAL] Portfolio value snapshot cadence.
# PORTFOLIO_SNAPSHOT_INTERVAL_SECONDS=3600

# [OPTIONAL] Daily-reminder job cadence.
# DAILY_REMINDER_TICK_INTERVAL_SECONDS=900

# [OPTIONAL] Resting-order matching cadence.
# SIM_RESTING_ORDER_TICK_INTERVAL_SECONDS=300

# [OPTIONAL] Sweep bracket orders each tick.
# SIM_BRACKET_SWEEP_ENABLED=true

# [OPTIONAL] Default short-borrow rate, % per year.
# SHORT_BORROW_DEFAULT_RATE_ANNUAL_PCT=3.0

# [OPTIONAL] Short initial margin multiple.
# SHORT_INITIAL_MARGIN=1.5

# [OPTIONAL] Short maintenance margin multiple.
# SHORT_MAINTENANCE_MARGIN=1.3

# [OPTIONAL] Halal screening feed. Match Alpha's live setting before go-live.
# SHARIA_SCREEN_ENABLED=false

# [OPTIONAL] SPUS holdings source for the Sharia screen.
# SHARIA_SPUS_HOLDINGS_URL=https://www.sp-funds.com/wp-content/uploads/data/TidalFG_Holdings_SPUS.csv

# [OPTIONAL] Parent-index constituents source for the Sharia screen.
# SHARIA_PARENT_INDEX_URL=https://raw.githubusercontent.com/datasets/s-and-p-500-companies/main/data/constituents.csv

# [OPTIONAL] HLAL holdings source for the Sharia screen.
# SHARIA_HLAL_HOLDINGS_URL=https://docs.google.com/spreadsheets/d/1UC1Bk67bGuYsos_i8y_HQpNoHpVHAvqf71MbgrafJOQ/export?format=csv&gid=0

# [OPTIONAL] Days before the Sharia list counts as stale.
# SHARIA_STALENESS_DAYS=7

# [OPTIONAL] Sharia hold-window days.
# SHARIA_HOLD_WINDOW_DAYS=30

# [OPTIONAL] Securities Commission Malaysia Shariah-compliant list (the `.KL` Sharia
# standard; only fetched while MARKET_BURSA_ENABLED=true). Stable index page; the
# newest PDF is discovered from it.
# SHARIA_SC_LIST_URL=https://www.sc.com.my/development/icm/shariah-compliant-securities/list-of-shariah-compliant-securities

# [OPTIONAL] Days before the SC Malaysia list counts as stale (semi-annual list).
# SHARIA_SC_STALENESS_DAYS=200

# [OPTIONAL] Sector/industry classification screens (no fossil fuels, etc.).
# CLASSIFICATION_SCREEN_ENABLED=false

# [OPTIONAL] Classification hold-window days.
# CLASSIFICATION_HOLD_WINDOW_DAYS=40

# [OPTIONAL] NASDAQ-listed symbol directory source.
# TICKER_REFERENCE_NASDAQ_LISTED_URL=https://www.nasdaqtrader.com/dynamic/symdir/nasdaqlisted.txt

# [OPTIONAL] Other-listed symbol directory source.
# TICKER_REFERENCE_NASDAQ_OTHER_URL=https://www.nasdaqtrader.com/dynamic/symdir/otherlisted.txt


# ======================================================================
# Accounts and compliance
# ======================================================================
# [REQUIRED] Refuse onboarding without the 18+ confirmation (CR273). Boot refuses false on Beta.
ONBOARDING_AGE_GATE_ENFORCED=true

# [REQUIRED] What the post-grace job does to a closed account (CR276): delete | anonymise | archive. Beta ships delete.
ACCOUNT_ERASURE_MODE=delete

# [OPTIONAL] Counsel's approval for archive mode (CR267 gate S6). Leave false: archive without it refuses boot.
# ACCOUNT_ARCHIVE_COUNSEL_APPROVED=false

# [OPTIONAL] Days a closed account stays restorable before erasure.
# ACCOUNT_CLOSURE_GRACE_DAYS=30

# [OPTIONAL] How often the erasure job looks for accounts whose grace has ended.
# ACCOUNT_ERASURE_TICK_INTERVAL_SECONDS=3600

# [REQUIRED] Sign in with Apple: the Beta build's bundle ID(s), comma-separated (WP-49 final IDs). Compose's default is Alpha's bundle ID; empty verifies against nothing.
APPLE_AUDIENCES=

# [REQUIRED] Sign in with Google: the Beta OAuth client ID(s), comma-separated. Empty verifies against nothing.
GOOGLE_AUDIENCES=


# ======================================================================
# Billing (RevenueCat Test Store: Beta builds stay internal-only, CR084)
# ======================================================================
# [REQUIRED] RevenueCat webhook shared secret (Beta project / Test Store). Empty = webhook refuses with 503.
REVENUECAT_WEBHOOK_SECRET=

# [REQUIRED] RevenueCat REST secret key (sk_...) for the Test Store project: Beta builds stay internal-only (CR084). Empty degrades alias transfer loudly.
REVENUECAT_SECRET_API_KEY=

# [REQUIRED] Play listing the forced-update screen sends Android testers to (DEF511). Must NOT name the personal Alpha package ai.agenticmarketintel.ami_trade; boot refuses it. Proposed company package (WP-49), confirm when the listing exists.
ANDROID_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=ai.agenticmarketintel.trade

# [OPTIONAL] TestFlight public join link for the client-version block screen.
# IOS_TESTFLIGHT_JOIN_URL=


# ======================================================================
# Email, push, observability
# ======================================================================
# [REQUIRED] Resend API key for magic-link and transactional email. Empty = no email; sign-in cannot complete.
RESEND_API_KEY=

# [REQUIRED] Sentry DSN for the backend (WP-44; a Beta project so release health is clean). Empty = no error reporting.
SENTRY_DSN=

# [REQUIRED] Operator alerts on 5xx rate, LLM spend vs ceiling and Room failure rate (WP-44). Beta runs them on; compose defaults to off for Alpha.
OPS_ALERTS_ENABLED=true

# [REQUIRED] Webhook that receives operator alerts as JSON {"text","content"} (Slack, Mattermost, Discord compatible). It is a secret URL. Empty with alerts on logs an error every tick.
OPS_ALERT_WEBHOOK_URL=

# [OPTIONAL] Alert when the share of HTTP responses with status 500 or above in the last 15 minutes reaches this fraction (needs 20 requests).
# OPS_ALERT_5XX_RATE=0.05

# [OPTIONAL] Alert when today's LLM spend reaches this fraction of LLM_DAILY_SPEND_CEILING_USD.
# OPS_ALERT_SPEND_FRACTION=0.8

# [OPTIONAL] Alert when the share of Rooms that finished failed in the last 60 minutes reaches this fraction (needs 5 finished Rooms).
# OPS_ALERT_ROOM_FAILURE_RATE=0.25

# [OPTIONAL] PostHog product-analytics key. Empty = off.
# POSTHOG_API_KEY=

# [REQUIRED] OneSignal app ID for push (Beta app or Alpha's; decide in WP-44).
ONESIGNAL_APP_ID=

# [REQUIRED] OneSignal REST key. Empty = push off.
ONESIGNAL_REST_KEY=

# [OPTIONAL] OneSignal Android channel id.
# ONESIGNAL_ANDROID_CHANNEL_ID=

# [OPTIONAL] SMTP relay host. Empty keeps SMTP a no-op (Resend is the path).
# SMTP_HOST=

# [OPTIONAL] SMTP relay port.
# SMTP_PORT=465

# [OPTIONAL] SMTP username.
# SMTP_USER=

# [OPTIONAL] SMTP password.
# SMTP_PASSWORD=

# [OPTIONAL] SMTP From address.
# SMTP_FROM=

# [OPTIONAL] api-website only; the marketing API is not run on Beta.
# WEBSITE_RESEND_FROM=AMI <support.ai@agenticmarketintel.ai>

# [OPTIONAL] api-website only; the marketing API is not run on Beta.
# WEBSITE_NOTIFY_EMAIL=

# [OPTIONAL] api-website only; the marketing API is not run on Beta.
# TURNSTILE_SECRET=


# ======================================================================
# Paper brokerage link
# ======================================================================
# [REQUIRED] Fernet key that encrypts linked paper-brokerage tokens at rest. Fresh for Beta (DEF182: outside local, empty refuses to store tokens). Generate: python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ALPACA_ENCRYPTION_KEY=

# [OPTIONAL] Retired Fernet key, read-only during rotation.
# ALPACA_ENCRYPTION_KEY_PREVIOUS=

# [OPTIONAL] Alpaca OAuth client id (paper linking). Empty = linking off.
# ALPACA_CLIENT_ID=

# [OPTIONAL] Alpaca OAuth client secret.
# ALPACA_CLIENT_SECRET=

# [OPTIONAL] Alpaca PAPER API base. Never a live account (D-075).
# ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# [OPTIONAL] Alpaca OAuth token endpoint.
# ALPACA_OAUTH_TOKEN_URL=https://api.alpaca.markets/oauth/token

# [OPTIONAL] Alpaca OAuth redirect URI of the app.
# ALPACA_REDIRECT_URI=amitrade://alpaca/callback


# ======================================================================
# Product limits and feature flags (defaults shown; diff against Alpha's live flags before go-live, WP-54)
# ======================================================================
# [OPTIONAL] LLM-written Portfolio Health prose.
# PORTFOLIO_HEALTH_LLM_ENABLED=true

# [OPTIONAL] Games: LLM desks on.
# GAMES_DESKS_ENABLED=true

# [OPTIONAL] Games: desk field size.
# GAMES_DESK_TARGET_FIELD_SIZE=8

# [OPTIONAL] Room dedup window while a Room runs.
# ROOM_DEDUP_RUNNING_MINUTES=30

# [OPTIONAL] Same inputs return the same Room (WP-24); false runs every convene fresh.
# ROOM_BANK_ENABLED=true

# [OPTIONAL] Seconds a model root read from /v1/models is trusted (part of the Room key).
# ROOM_MODEL_ROOT_TTL_S=300

# [OPTIONAL] Room data pull-back days, social.
# ROOM_PULLBACK_DAYS_SOCIAL=0

# [OPTIONAL] Room data pull-back days, news.
# ROOM_PULLBACK_DAYS_NEWS=0

# [OPTIONAL] Room data pull-back days, market.
# ROOM_PULLBACK_DAYS_MARKET=0

# [OPTIONAL] Go-to-market funnel mode: none | ...; see config.py.
# GTM_FUNNEL=none

# [OPTIONAL] Cooldown on the win-zip (credit) action.
# WINZIP_COOLDOWN_MINUTES=5

# [OPTIONAL] Credits per 1-on-1.
# ONE_ON_ONE_CREDIT_COST=1

# [OPTIONAL] Credits per Brief.
# BRIEF_CREDIT_COST=1

# [OPTIONAL] Hide the analyst-consensus block from agents.
# SUPPRESS_ANALYST_CONSENSUS=false

# [OPTIONAL] How much context the Concierge gets.
# CONCIERGE_CONTEXT_MODE=full_context

# [OPTIONAL] Max bytes per bug-report attachment.
# BUG_ATTACHMENT_MAX_BYTES=5242880

# [OPTIONAL] Total disk cap for stored attachments.
# BUG_ATTACHMENTS_TOTAL_CAP_BYTES=2147483648

# [OPTIONAL] Days attachments are kept.
# BUG_ATTACHMENTS_RETENTION_DAYS=60

# [OPTIONAL] Concurrent agent streams allowed per user.
# AGENT_STREAM_MAX_CONCURRENT_PER_USER=2

# [OPTIONAL] Proxy CIDRs whose X-Forwarded-For is trusted (the tunnel peer). Confirm it covers the Beta host's Docker network.
# RATE_LIMIT_TRUSTED_PROXY_CIDRS=172.16.0.0/12

# [OPTIONAL] CIO self-consistency samples per verdict.
# PM_SELF_CONSISTENCY_SAMPLES=5

# [OPTIONAL] Max scripted fallback turns per Room.
# ROOM_MAX_SCRIPTED_TURNS=4

# [OPTIONAL] Max age of a Room the CIO retry will revive.
# ROOM_CIO_RETRY_MAX_AGE_MINUTES=240

# [OPTIONAL] CIO option-ladder feature.
# PM_OPTION_LADDER_ENABLED=false

# [OPTIONAL] Risk Officer agent feature.
# ROOM_RISK_OFFICER_ENABLED=false

# [OPTIONAL] Room numeric quotation checks: annotate writes [AMI checked ...] / [AMI: unverifiable] notes into Room text; log only logs each finding (room_factcheck_finding) and changes no text (DEF547).
# ROOM_FACTCHECK_NOTES=annotate

# [OPTIONAL] Seed debate order for reproducibility.
# ROOM_DEBATE_ORDER_SEEDED=false

# [OPTIONAL] JSON-schema constraint on the CIO verdict.
# ROOM_JSON_CONSTRAINTS_ENABLED=true

# [OPTIONAL] Execution Desk regex constraint.
# ROOM_TRADER_REGEX_ENABLED=false

# [OPTIONAL] Fundamentals: debt maturity.
# ROOM_DEBT_MATURITY_ENABLED=true

# [OPTIONAL] Fundamentals: cost of debt.
# ROOM_COST_OF_DEBT_ENABLED=true

# [OPTIONAL] Fundamentals: cash-flow bridge.
# ROOM_CASHFLOW_BRIDGE_ENABLED=true

# [OPTIONAL] Fundamentals: FCF from statements.
# FUNDAMENTALS_FCF_FROM_STATEMENTS_ENABLED=true

# [OPTIONAL] Fundamentals: FCF history.
# ROOM_FCF_HISTORY_ENABLED=true

# [OPTIONAL] Fundamentals: FCF conversion.
# ROOM_FCF_CONVERSION_ENABLED=true

# [OPTIONAL] Fundamentals: ROE history.
# ROOM_ROE_HISTORY_ENABLED=true

# [OPTIONAL] Fundamentals: debt split.
# ROOM_DEBT_SPLIT_ENABLED=true

# [OPTIONAL] Fundamentals: segment revenue.
# ROOM_SEGMENT_REVENUE_ENABLED=false

# [OPTIONAL] Fundamentals: geographic revenue.
# ROOM_GEOGRAPHIC_REVENUE_ENABLED=false

# [OPTIONAL] Fundamentals: executive changes.
# ROOM_EXECUTIVE_CHANGE_ENABLED=false

# [OPTIONAL] Fundamentals: recent filings.
# ROOM_RECENT_FILINGS_ENABLED=false

# [OPTIONAL] Execution Desk + Conservative Risk Officer: float and dollar volume.
# ROOM_FLOAT_LIQUIDITY_ENABLED=false

# [OPTIONAL] Fundamentals: dividend growth.
# ROOM_DIVIDEND_GROWTH_ENABLED=false

# [OPTIONAL] Fundamentals: buyback price.
# ROOM_BUYBACK_PRICE_ENABLED=false

# [OPTIONAL] Fundamentals: stock-based comp.
# ROOM_SBC_ENABLED=true

# [OPTIONAL] Fundamentals: ROIC.
# ROOM_ROIC_ENABLED=true

# [OPTIONAL] Flow: put/call ratio.
# ROOM_PUT_CALL_ENABLED=true

# [OPTIONAL] Fundamentals: peer comparison.
# ROOM_PEER_COMPARISON_ENABLED=true

# [OPTIONAL] Fundamentals: WACC.
# ROOM_WACC_ENABLED=true

# [OPTIONAL] Flow: insider ratio.
# ROOM_INSIDER_RATIO_ENABLED=true

# [OPTIONAL] Flow: 10b5-1 plan tag.
# ROOM_INSIDER_PLAN_TAG_ENABLED=true

# [OPTIONAL] Flow: insider clusters.
# ROOM_INSIDER_CLUSTER_ENABLED=true

# [OPTIONAL] Events: 8-K flags.
# ROOM_EDGAR_8K_FLAGS_ENABLED=true

# [OPTIONAL] Events: nightly 8-K Item 5.02 re-scan look-back in days (DEF447; must be >= 180).
# EDGAR_8K_RESCAN_WINDOW_DAYS=365

# [OPTIONAL] Macro: BLS direct source for CPI/PPI (CR229). Off: FRED stays primary.
# MACRO_DIRECT_BLS_ENABLED=false

# [OPTIONAL] Macro: BLS registration key (free). Empty = API v1, 25 queries/day.
# BLS_API_KEY=

# [OPTIONAL] Verdict review: veto pass (production setting ON).
# ROOM_VETO_REVIEW_ENABLED=true

# [OPTIONAL] Verdict review: resurrection pass (production setting ON).
# ROOM_RESURRECTION_REVIEW_ENABLED=true

# [OPTIONAL] Structured card envelope on agent output.
# ROOM_CARDS_ENVELOPE_ENABLED=false

# [OPTIONAL] CR266 PM evidence gate; off until per-provider thresholds are calibrated.
# ROOM_EVIDENCE_GATE_ENABLED=false

# [OPTIONAL] CR266 per-provider approval thresholds (JSON).
# ROOM_EVIDENCE_GATE_THRESHOLDS_JSON={

# [OPTIONAL] CR266 contested-evidence margin.
# ROOM_EVIDENCE_CONTESTED_MARGIN=0.1

# [OPTIONAL] CR267 WP-23 coded decision rule: a grader's answers compute the Room's action, the CIO narrates it. Off by default.
# ROOM_CODED_RULE_ENABLED=false

# [OPTIONAL] CR267 WP-23 registered grader name; empty or unknown ends the Room "decision unavailable".
# ROOM_GRADER=

# [OPTIONAL] CR267 WP-23 per-grader R1..R5 rule ladder (JSON); empty object uses the built-in ladder.
# ROOM_CODED_RULE_POLICY_JSON={}

# [OPTIONAL] CR267 WP-23 hosted grader (ROOM_GRADER=deepinfra). Called directly, never through the gateway; the desks' provider
# allow-list is unaffected. With the rule on and this grader chosen, an empty key refuses boot. Model id is pinned, never "latest".
# [OPTIONAL] CR267 WP-23 DeepInfra grader endpoint.
# ROOM_GRADER_DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai

# [OPTIONAL] CR267 WP-23 DeepInfra grader model (pinned id, never "latest").
# ROOM_GRADER_DEEPINFRA_MODEL=deepseek-ai/DeepSeek-V4-Flash

# [OPTIONAL] CR267 WP-23 DeepInfra grader key; required (boot refuses) only when the rule is on with ROOM_GRADER=deepinfra.
# ROOM_GRADER_DEEPINFRA_API_KEY=

# [OPTIONAL] CR267 WP-23 DeepInfra grader per-call timeout, seconds.
# ROOM_GRADER_DEEPINFRA_TIMEOUT_S=30.0

# [OPTIONAL] CR267 WP-23 on-prem grader (ROOM_GRADER=ling). Calls the gateway's vllm_fallback slot (VLLM_FALLBACK_BASE_URL,
# VLLM_FALLBACK_MODEL pinned, VLLM_FALLBACK_KIND=vllm; LLM_PROVIDER_ALLOWLIST must include vllm_fallback). With the rule on
# and this grader chosen, a missing slot refuses boot. Per-call timeout, seconds.
# ROOM_GRADER_LING_TIMEOUT_S=60.0
# [OPTIONAL] CR267 term=v2: which terminal-vulnerability question the Ling grader asks, v1 (the shared one, default) or v2 (the
# tighter question whose yes needs a named category and grounded evidence, checked in code). Anything else refuses boot.
# ROOM_GRADER_LING_TERMINAL=v1

# [OPTIONAL] Require pre-registration before training trades.
# TRAINING_PREREGISTRATION_REQUIRED=false

# [OPTIONAL] Pre-registration also for long-horizon trades.
# PREREG_APPLIES_TO_LONG_HORIZON=false

# [OPTIONAL] Passive-twin benchmark.
# PORTFOLIO_PASSIVE_TWIN_ENABLED=false

# [OPTIONAL] Passive-twin default ticker.
# PASSIVE_TWIN_DEFAULT_TICKER=SPY

# [OPTIONAL] Passive-twin halal ticker.
# PASSIVE_TWIN_HALAL_TICKER=

# [OPTIONAL] Passive-twin expense ratio, %.
# PASSIVE_TWIN_DEFAULT_EXPENSE_RATIO_PCT=0.0945

# [OPTIONAL] Passive-twin halal expense ratio, %.
# PASSIVE_TWIN_HALAL_EXPENSE_RATIO_PCT=0.0

# [OPTIONAL] Twin minimum market days.
# TWIN_MIN_MARKET_DAYS=20

# [OPTIONAL] Twin minimum market days for standard error.
# TWIN_MIN_MARKET_DAYS_FOR_SE=60

# [OPTIONAL] Simulated trading cost ("toll").
# TRAINING_TOLL_ENABLED=false

# [OPTIONAL] Toll, basis points.
# TRAINING_TOLL_BPS=10.0

# [OPTIONAL] Toll minimum, USD.
# TRAINING_TOLL_MIN=1.0

# [OPTIONAL] Option toll, basis points.
# TRAINING_TOLL_OPTION_BPS=50.0

# [OPTIONAL] Behaviour diagnostics.
# PORTFOLIO_BEHAVIOUR_DIAGNOSTICS_ENABLED=false

# [OPTIONAL] Diagnostics: minimum trades.
# MIN_TRADES_FOR_DIAGNOSTICS=10

# [OPTIONAL] Diagnostics: minimum elapsed days.
# MIN_ELAPSED_DAYS_FOR_DIAGNOSTICS=60

# [OPTIONAL] Reputation points per day cap.
# REPUTATION_DAILY_CAP=25

# [OPTIONAL] League cohort size.
# LEAGUE_COHORT_SIZE=30

# [OPTIONAL] League promotions per cycle.
# LEAGUE_PROMOTE_COUNT=5

# [OPTIONAL] League relegations per cycle.
# LEAGUE_RELEGATE_COUNT=5

# [OPTIONAL] Plans eligible for leagues; empty = all.
# LEAGUE_ELIGIBLE_PLANS=

# [OPTIONAL] Portfolio Health gating mode.
# PORTFOLIO_HEALTH_GATE_MODE=trial

# [OPTIONAL] Portfolio Health trial days.
# PORTFOLIO_HEALTH_TRIAL_DAYS=14

# [OPTIONAL] Portfolio Health trial findings.
# PORTFOLIO_HEALTH_TRIAL_FINDINGS=3

# [OPTIONAL] Portfolio Health daily cap.
# PORTFOLIO_HEALTH_DAILY_CAP=2

# [OPTIONAL] Plans with Portfolio Health.
# PORTFOLIO_HEALTH_PLANS=trader,floor_manager

# [OPTIONAL] Portfolio Health cadence, days.
# PORTFOLIO_HEALTH_CADENCE_DAYS=30

# [OPTIONAL] Daily verdict outcome scoring (WP-28). false is the kill switch.
# OUTCOME_SCORING_ENABLED=true

# [OPTIONAL] UTC hour of the daily scoring run (WP-28).
# OUTCOME_SCORING_HOUR_UTC=22

# [OPTIONAL] UTC minute of the daily scoring run (WP-28).
# OUTCOME_SCORING_MINUTE_UTC=30

# [OPTIONAL] Most due verdicts scored per run (WP-28).
# OUTCOME_SCORING_BATCH_LIMIT=500

# [OPTIONAL] Most distinct tickers refreshed from Yahoo per run (WP-28).
# OUTCOME_SCORING_MAX_TICKER_FETCHES=150

# [OPTIONAL] A horizon bar older than this many days counts as missing (WP-28).
# OUTCOME_SCORING_MAX_BAR_GAP_DAYS=5

# [OPTIONAL] Where the weekly Room outcome report is written; must be a writable mount (WP-28).
# OUTCOME_REPORT_DIR=/backtest_results/outcome_reports

# [OPTIONAL] Days between Room outcome reports (WP-28).
# OUTCOME_REPORT_INTERVAL_DAYS=7
# [OPTIONAL] CR287 sector-aware metrics: banks get FCF, net debt, EV/EBITDA and interest coverage stated "not applicable"; regulated utilities get one context line; both skip the debt-default check. Off: sheets are unchanged.
# ROOM_SECTOR_METRICS_ENABLED=false
