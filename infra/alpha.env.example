# AMI Trade — Alpha environment env file (shape only).
#
# Copy this to `infra/alpha.env` (gitignored), fill in real values, and
# /promote-to-alpha ships it to melehost:~/ami_trade/.env. The Mac is
# canonical: edit alpha.env here, then promote. melehost's .env is
# treated as derivative — never edit it in-place.
#
# Rotate any value here in its source dashboard if you suspect a leak.

# ── Cloudflare Tunnel connector token (A7) ──────────────────────────────
# Source: https://one.dash.cloudflare.com/ → Networks → Tunnels → ami-trade.
# Anyone holding this token can answer for the tunnel hostname — rotate
# in the CF dashboard if it leaks. Used by docker-compose (cloudflared
# service, --profile tunnel).
CF_TUNNEL_TOKEN=

# ── vLLM (on-prem Gemma 4) ──────────────────────────────────────────────
# The gateway prefers vllm > anthropic > mock. Unset to fall back.
VLLM_BASE_URL=http://192.168.20.74:8000
VLLM_MODEL=ami-llm
# Optional bearer token if the vLLM host gets hardened later.
VLLM_API_KEY=

# ── Market data ─────────────────────────────────────────────────────────
# `true` flips quotes from the deterministic mock walk to live Yahoo
# (with mock_walk fallback on 429 / network errors). The per-call source
# is reported truthfully via Quote.source — see app/services/market_data.py.
USE_REAL_MARKET_DATA=true

# ── Room dedup windows ───────────────────────────────────────────────────
# See app/services/room_runner.py::start_run.
# running_minutes:  in-flight dedup + startup-sweep cutoff
# completed_hours:  return prior verdict if same user+ticker submitted again
#                   within this window. 24 h ≈ same trading day. Design doc
#                   default was 5 days (120 h); we start tighter so a re-run
#                   after the next open isn't blocked. Set 0 to disable.
ROOM_DEDUP_RUNNING_MINUTES=30
ROOM_DEDUP_COMPLETED_HOURS=24

# ── Auth (AT:R25 Phase 1.5) ─────────────────────────────────────────────
# `staging` triggers the post-audit security posture: legacy unsigned
# tokens rejected, magic-link debug code never returned via response,
# Apple endpoint returns 503 until Phase 3 JWT verification lands.
# `local` re-enables the dev affordances (only safe on the developer's
# machine, never on a host with a public tunnel).
#
# Compose maps ${AMI_ENV:-local} → container's ENV. The pydantic field
# name on the backend is `env`, so don't set `ENV=…` in this file — set
# `AMI_ENV=…` (compose forwards it). Don't ask why; touchy plumbing.
AMI_ENV=staging

# HMAC key for scaffold Bearer tokens. Boot check in backend/app/main.py
# refuses to start when AMI_ENV != local and this is the default value.
# Generate a fresh one with: openssl rand -hex 32
# Rotate by replacing the value and re-promoting — old tokens become
# invalid, clients silently re-bootstrap.
SECRET_KEY=

# ── Apple Sign-In ───────────────────────────────────────────────────────
# Comma-separated audiences for the identity token's `aud` claim. iOS
# native uses the bundle ID; add a Web Services ID here if Apple sign-in
# ever ships via web. Defaults to the iOS bundle in config.py — only
# set this when you need to override or add audiences.
# APPLE_AUDIENCES=ai.agenticmarketintel.amiTrade

# ── Google Sign-In (AT:R36, D-057 — Android alpha) ──────────────────────
# Comma-separated audiences for the Google ID token's `aud` claim.
# Value = OAuth 2.0 **Web client_id** from GCP Console (NOT the Android
# client_id — Google stamps the Web client ID into ID tokens returned
# to the Android client). Empty = Google Sign-In rejects every token at
# the audience check (safe default).
#
# Setup (per D-057):
#   1. Enable Google Sign-In API in the existing GCP project.
#   2. Create OAuth 2.0 Android client (package ai.agenticmarketintel.ami_trade
#      + SHA-1 from ~/.android-keys/ami-trade-upload.keystore).
#   3. Create OAuth 2.0 Web client (no redirect URI needed). Its Client ID
#      goes here.
GOOGLE_AUDIENCES=

# ── Admin back-office (AT:R27) ──────────────────────────────────────────
# Static bearer secret for all /v1/admin/* routes. Empty = admin disabled.
# Generate: openssl rand -hex 32
# Pass as: Authorization: Bearer <value>
# Beta: replaced by admin_users table + JWT; middleware accepts both.
ADMIN_SECRET=

# ── SMTP (magic-link email delivery) ────────────────────────────────────
# When SMTP_HOST is empty, the backend skips sending and the 6-digit code
# is only visible in the UI debug chip (alpha-tester mode).
# Port 465 = implicit SSL (SMTP_SSL). Port 587 = STARTTLS (auto-selected).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
