# CR246 — env shape for the ami-loadtest stack on minihost.
#
# This is the committed SHAPE only. The real file lives at
# infra/loadtest/.env on minihost (~/ami_loadtest/infra/loadtest/.env) and is
# generated by deploy.sh on first deploy — secrets never cross back to the Mac.
# Regenerate any value with: openssl rand -hex 32

POSTGRES_PASSWORD=<openssl rand -hex 32>
REDIS_PASSWORD=<openssl rand -hex 32>
SECRET_KEY=<openssl rand -hex 32>
ADMIN_SECRET=<openssl rand -hex 32>
POSTGRES_USER=postgres
