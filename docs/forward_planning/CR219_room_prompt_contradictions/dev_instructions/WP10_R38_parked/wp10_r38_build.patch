+# ── CR219 R38 — the captive-finance entity registry ─────────────────────────
+#
+# An industrial with a captive lender reports ONE blended `total_debt`. The
+# parent's equipment-manufacturing leverage and the subsidiary's lending book
+# are different credit profiles — a finance arm is SUPPOSED to run leveraged,
+# an industrial parent is not — and a single figure cannot be read as either.
+#
+# Matching is by ENTITY NAME, not by a us-gaap tag: the debt tags are the same
+# `DEBT_ANCHOR`/`DEBT_OPTIONAL_ADD` ones already ingested. What distinguishes
+# the finance arm's figure is the XBRL dimension it is reported under (a
+# `LegalEntityAxis` / `ConsolidatedEntitiesAxis` member), and member names are
+# fuzzy real-world strings, not a clean enum — CAT alone appears as
+# `CaterpillarFinancialServicesCorporationMember`,
+# `FinancialProductsMember`, and `CatFinancialMember` across filings and
+# periods. So each ticker carries a tuple of NORMALISED substrings (lowercase,
+# non-alphanumerics stripped) and a member matches if any one of them is
+# contained in the normalised member name.
+#
+# Three entries, deliberately: US heavy-equipment names with a named,
+# SEC-registered captive lender. This is a manual registry by design — a
+# name-similarity heuristic would eventually match a segment that is not a
+# lending book at all, and a wrong split is worse than no split.
+_CAPTIVE_FINANCE_MEMBERS: dict[str, tuple[str, ...]] = {
+    "CAT": (
+        "caterpillarfinancialservices",
+        "catfinancial",
+        "financialproducts",
+    ),
+    "DE": (
+        "johndeerecapital",
+        "financialservices",
+    ),
+    "PCAR": (
+        "paccarfinancial",
+        "financialservices",
+    ),
+}
+
+# The human-readable name of each captive lender, for the rendered line. Kept
+# beside the match substrings rather than derived from them: the substrings are
+# normalised match keys and would render as `caterpillarfinancialservices`.
+CAPTIVE_FINANCE_NAMES: dict[str, str] = {
+    "CAT": "Caterpillar Financial Services",
+    "DE": "John Deere Capital",
+    "PCAR": "PACCAR Financial",
+}
+
+# Namespace for the dimensional facts the ingest resolves. They are DERIVED
+# figures (a member-resolved value, and a whole-company-minus-member
+# remainder), not raw us-gaap facts, so they must never collide with a real
+# tag name in `INGEST_TAGS_US_GAAP` — an `ami:` prefix and its own taxonomy
+# string keep them separable in the store and un-readable by the PIT resolver,
+# which only ever asks for us-gaap/dei tags by name.
+DEBT_SPLIT_TAXONOMY = "ami"
+DEBT_SPLIT_CAPTIVE_TAG = "ami:CaptiveFinanceDebt"
+DEBT_SPLIT_INDUSTRIAL_TAG = "ami:IndustrialDebt"
+DEBT_SPLIT_TAGS = (DEBT_SPLIT_CAPTIVE_TAG, DEBT_SPLIT_INDUSTRIAL_TAG)
+
+
+def normalize_member_name(name: str) -> str:
+    """Lowercase, alphanumerics only — the comparison basis for member matching.
+
+    XBRL member names arrive with varying case, whitespace, punctuation and
+    the trailing `Member` suffix; every one of those varies between filers and
+    between periods for one filer. Stripping to alphanumerics is what makes
+    `Caterpillar Financial Services Corporation [Member]` and
+    `CaterpillarFinancialServicesCorporationMember` the same string.
+    """
+    return "".join(ch for ch in str(name).lower() if ch.isalnum())
+
+
+def match_captive_finance_member(ticker: str, member_name: str) -> bool:
+    """Does `member_name` name this ticker's known captive-finance subsidiary?
+
+    False for every ticker not in the registry — the overwhelming majority.
+    That is the COMMON case, not an outage: a company with no captive lender
+    has a one-part debt structure, and the caller must render nothing extra
+    rather than a "split unavailable" disclaimer (CR040 / the R38 note's
+    failure-mode section).
+    """
+    keys = _CAPTIVE_FINANCE_MEMBERS.get(str(ticker).upper().strip())
+    if not keys:
+        return False
+    normalized = normalize_member_name(member_name)
+    if not normalized:
+        return False
+    return any(key in normalized for key in keys)
+
+
+def captive_finance_tickers() -> tuple[str, ...]:
+    """Every ticker the registry knows a captive lender for."""
+    return tuple(sorted(_CAPTIVE_FINANCE_MEMBERS))
