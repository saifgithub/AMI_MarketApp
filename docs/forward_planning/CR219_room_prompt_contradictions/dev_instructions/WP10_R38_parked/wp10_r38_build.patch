+def _segment_member_names(fact: dict) -> list[str]:
+    """Every member name carried on one companyfacts fact's `segment` object.
+
+    The shape varies: a single-axis fact carries one `{"dim": ..., "mem": ...}`
+    object, a multi-axis fact carries a list of them, and some payloads name
+    the member under `member` rather than `mem`. All three are read; anything
+    else yields no names, which makes the fact non-dimensional as far as this
+    parser is concerned — the conservative direction, since an unrecognised
+    shape must never be mistaken for a whole-company figure.
+    """
+    segment = fact.get("segment")
+    if not segment:
+        return []
+    entries = segment if isinstance(segment, list) else [segment]
+    names: list[str] = []
+    for entry in entries:
+        if isinstance(entry, str):
+            names.append(entry)
+            continue
+        if not isinstance(entry, dict):
+            continue
+        for key in ("mem", "member", "value"):
+            value = entry.get(key)
+            if isinstance(value, str) and value:
+                names.append(value)
+                break
+    return names
+
