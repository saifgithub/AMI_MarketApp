+# The three non-error states are DISTINCT, and conflating any of them with the
+# fourth is the silent-fallback shape CR040 forbids:
+#   * no captive-finance segment stored → returns `{}`, no `debt_split` key.
+#     The common case (every ticker with no captive lender) and NOT a gap.
+#   * segment known but this period unresolvable → `debt_split_state` =
+#     "unresolved", rendered as an explicit line, never as the blended figure
+#     relabelled as a split.
+#   * store unreachable → logged loudly, `debt_split_state` = "unresolved".
+#     The blended `total_debt` has its own independent yfinance provenance and
+#     is untouched: a split outage must never take the debt TOTAL down.
+_DEBT_SPLIT_UNRESOLVED = "unresolved"
+_DEBT_SPLIT_RESOLVED = "resolved"
+
+
+def fetch_debt_split(ticker: str) -> dict[str, Any]:
+    """The stored captive-finance / industrial debt split for one ticker.
+
+    Returns `{}` when the ticker has no known captive-finance subsidiary —
+    the caller must then render nothing extra and set no `field_state` key.
+    Returns `{"debt_split_state": "unresolved", ...}` when the subsidiary IS
+    known but the store carries no resolvable figures for it, and the fully
+    populated dict when it does.
+
+    Never raises. A store outage degrades this one line, not the sheet.
+    """
+    from app.services import edgar_tags  # lazy: keeps this module import-light
+
+    key = str(ticker).upper().strip()
+    lender = edgar_tags.CAPTIVE_FINANCE_NAMES.get(key)
+    if lender is None:
+        return {}
+
+    out: dict[str, Any] = {
+        "debt_split_state": _DEBT_SPLIT_UNRESOLVED,
+        "debt_split_entity": lender,
+    }
+    try:
+        from sqlalchemy import select
+
+        from app.db import get_session
+        from app.db.models import EdgarFactRow
+
+        # Stored tags are `<half>:<source us-gaap tag>` — the source tag is
+        # kept in the name so the two halves are only ever subtracted from a
+        # figure of the SAME debt concept.
+        prefixes = {f"{half}:": half for half in edgar_tags.DEBT_SPLIT_TAGS}
+        with get_session() as session:
+            rows = session.execute(
+                select(
+                    EdgarFactRow.tag, EdgarFactRow.value,
+                    EdgarFactRow.period_end, EdgarFactRow.filed,
+                ).where(
+                    EdgarFactRow.ticker == key,
+                    EdgarFactRow.taxonomy == edgar_tags.DEBT_SPLIT_TAXONOMY,
+                ),
+            ).all()
+    except Exception as exc:
+        logger.warn("edgar_debt_split_error", ticker=key, error=str(exc)[:200])
+        return out
+
+    # Anchor-tag preference, mirroring `DEBT_ANCHOR`'s own ordering: the two
+    # halves must be resolved off the SAME source us-gaap tag and the SAME
+    # filing, or the split is two different debt concepts subtracted from each
+    # other. Latest period_end wins, ties broken by latest filed — the same
+    # rule `edgar_pit.resolve_instant_dated` applies to amendments.
+    by_source: dict[tuple[str, date, date], dict[str, float]] = {}
+    for tag, value, period_end, filed in rows:
+        for prefix, half in prefixes.items():
+            if not str(tag).startswith(prefix):
+                continue
+            source_tag = str(tag)[len(prefix):]
+            slot = by_source.setdefault((source_tag, period_end, filed), {})
+            slot[half] = float(value)
+            break
+    resolvable = [
+        (source_tag, period_end, filed, halves)
+        for (source_tag, period_end, filed), halves in by_source.items()
+        if len(halves) == 2
+    ]
+    if not resolvable:
+        return out
+
+    for anchor in edgar_tags.DEBT_ANCHOR:
+        candidates = [r for r in resolvable if r[0] == anchor]
+        if candidates:
+            break
+    else:
+        candidates = resolvable
+    source_tag, period_end, filed, halves = max(
+        candidates, key=lambda r: (r[1], r[2]),
+    )
+    captive = halves[edgar_tags.DEBT_SPLIT_CAPTIVE_TAG]
+    industrial = halves[edgar_tags.DEBT_SPLIT_INDUSTRIAL_TAG]
+    out["debt_split_state"] = _DEBT_SPLIT_RESOLVED
+    out["debt_split_captive"] = round(captive / 1_000_000)
+    out["debt_split_industrial"] = round(industrial / 1_000_000)
+    out["debt_split_period"] = period_end.isoformat()
+    return out
+
+
+def debt_split_line(
+    state: str | None, entity: str | None,
+    captive: int | None, industrial: int | None, period: str | None,
+    *, live: bool = True,
+) -> str | None:
+    """CR219 R38 — the debt split, or an explicit statement that it is missing.
+
+    Three renderings, one per state the note distinguishes:
+
+    * `state is None` → `None`. Either the flag is off or this company has no
+      captive lender. Neither is a data gap, so neither gets a disclaimer:
+      a company with no finance arm has a one-part debt structure, and a
+      feature nobody has enabled has not failed.
+    * `state == "unresolved"` → the explicit UNAVAILABLE line. The subsidiary
+      is known to exist and the sheet says so, rather than letting the blended
+      total read as if it were the industrial figure.
+    * `state == "resolved"` → both halves, named, dated.
+
+    The blended `total_debt` line is never touched by any of these — it has
+    its own provenance and answers a different question.
+    """
+    if state is None:
+        return None
+    if state != _DEBT_SPLIT_RESOLVED or captive is None or industrial is None:
+        who = entity or "a captive finance subsidiary"
+        return _labelled(
+            "Debt split (industrial vs. captive finance)", live,
+            [
+                f"UNAVAILABLE — {who} is a consolidated subsidiary, but this "
+                "period's split could not be resolved from the filed facts. "
+                "The gross debt figure above is the BLENDED total and must not "
+                "be read as the industrial parent's own leverage"
+            ],
+        )
+    parts = [f"industrial ${industrial:,}M", f"captive finance ${captive:,}M"]
+    if entity:
+        parts.append(f"finance arm: {entity}")
+    if period:
+        parts.append(f"as of {period}")
+    line = _labelled("Debt split (industrial vs. captive finance)", live, parts)
+    return (
+        f"{line}. The two halves are different credit profiles — a captive "
+        "lender is funded to lend and is expected to carry leverage the "
+        "industrial parent is not; the blended gross-debt figure above "
+        "conflates them."
+    )
+
