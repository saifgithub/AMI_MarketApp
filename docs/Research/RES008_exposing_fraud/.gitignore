# Provenance (video IDs, channel names, transcript index) is internal-only.
# This repo is public and RES008 never names a channel — see README "Publication rules".
_internal/
# Downloaded price caches are reproducible from code and do not belong in git.
**/cache/
**/__pycache__/
# large intermediate arrays — regenerated by the run scripts
**/*.npz
# full per-day series behind a slimmed results.json — regenerated by the run script
**/results_full.json
